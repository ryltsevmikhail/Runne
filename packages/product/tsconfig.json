{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@gocode/product/*": ["./*"]
    },
    "baseUrl": "."
  },
  "include": ["shared/**/*.ts", "shared/**/*.vue"]
}
