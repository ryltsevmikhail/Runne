{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@runne/product/*": ["./*"]
    },
    "baseUrl": "."
  },
  "include": [
    "shared/**/*.ts",
    "shared/**/*.vue",
    "features/**/*.ts",
    "features/**/*.vue",
    "widgets/attention-queue/**/*.ts",
    "widgets/attention-queue/**/*.vue",
    "entities/task-run/**/*.ts",
    "entities/task-run/**/*.vue"
  ]
}
