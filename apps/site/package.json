{
  "name": "@runne/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && node scripts/build.mjs",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:prerender": "node scripts/verify-prerender.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:prerender",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@vue/server-renderer": "3.5.28",
    "vue": "3.5.28",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "vue-tsc": "3.2.5",
    "wrangler": "4.118.0"
  }
}
