{
  "$defs": {
    "mutationAcknowledgement": {
      "additionalProperties": false,
      "properties": {
        "providerId": {
          "enum": [
            "openai",
            "deepseek"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "configured",
            "missing",
            "unsupported",
            "access_denied",
            "identity_mismatch",
            "unavailable"
          ],
          "type": "string"
        }
      },
      "required": [
        "providerId",
        "status"
      ],
      "type": "object"
    },
    "pairRequest": {
      "additionalProperties": false,
      "properties": {
        "credential": {
          "maxLength": 5462,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        }
      },
      "required": [
        "credential"
      ],
      "type": "object"
    }
  },
  "$id": "gocode://schemas/provider-credentials-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {},
  "required": [],
  "title": "Provider Credential Control V1",
  "type": "object"
}
