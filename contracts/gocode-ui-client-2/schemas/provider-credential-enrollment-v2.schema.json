{
  "$defs": {
    "beginRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "pair",
            "revoke",
            "migrate_legacy"
          ],
          "type": "string"
        },
        "commandIdentity": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "expectedLifecycleRevision": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "nativeIntentId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai",
            "deepseek"
          ],
          "type": "string"
        }
      },
      "required": [
        "action",
        "provider",
        "expectedLifecycleRevision",
        "commandIdentity",
        "idempotencyKey",
        "nativeIntentId"
      ],
      "type": "object"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "requestId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "code",
        "requestId"
      ],
      "type": "object"
    },
    "operationResponse": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operationKind": {
                "enum": [
                  "pair",
                  "revoke",
                  "migrate_legacy"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "brokerRendezvousId": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operationKind": {
                "enum": [
                  "verify_local",
                  "verify_remote"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "brokerRendezvousId": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "brokerRendezvousId": {
          "oneOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanupPending": {
          "type": "boolean"
        },
        "lastDisposition": {
          "oneOf": [
            {
              "enum": [
                "completed",
                "access_denied",
                "unsupported",
                "unavailable",
                "conflict",
                "invalid_request",
                "invariant_failure"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycleRevision": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "operationId": {
          "pattern": "^[0-9a-f]{96}$",
          "type": "string"
        },
        "operationKind": {
          "enum": [
            "pair",
            "revoke",
            "migrate_legacy",
            "verify_local",
            "verify_remote"
          ],
          "type": "string"
        },
        "providerId": {
          "enum": [
            "openai",
            "deepseek"
          ],
          "type": "string"
        },
        "readinessRevision": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "state": {
          "enum": [
            "prepared",
            "claimed",
            "native_effect_observed",
            "readback_verified",
            "completed",
            "failed",
            "expired",
            "cancelled",
            "tombstoned"
          ],
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "brokerRendezvousId",
        "providerId",
        "operationKind",
        "state",
        "lifecycleRevision",
        "readinessRevision",
        "cleanupPending",
        "lastDisposition"
      ],
      "type": "object"
    },
    "resumeRequest": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "pattern": "^[0-9a-f]{96}$",
          "type": "string"
        }
      },
      "required": [
        "operationId"
      ],
      "type": "object"
    },
    "statusResponse": {
      "additionalProperties": false,
      "properties": {
        "cleanupPending": {
          "type": "boolean"
        },
        "credentialState": {
          "enum": [
            "configured",
            "missing",
            "access_denied",
            "unsupported",
            "unavailable"
          ],
          "type": "string"
        },
        "lastDisposition": {
          "oneOf": [
            {
              "enum": [
                "completed",
                "access_denied",
                "unsupported",
                "unavailable",
                "conflict",
                "invalid_request",
                "invariant_failure"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycleRevision": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "observedAt": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "pendingOperation": {
          "oneOf": [
            {
              "enum": [
                "pairing",
                "rotating",
                "revoking",
                "reconciling",
                "verifying"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerId": {
          "enum": [
            "openai",
            "deepseek"
          ],
          "type": "string"
        },
        "readiness": {
          "enum": [
            "ready",
            "missing",
            "stale",
            "unavailable",
            "unsupported",
            "access_denied",
            "conflict",
            "invariant_failure"
          ],
          "type": "string"
        },
        "readinessRevision": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "verificationRevision": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "verificationState": {
          "enum": [
            "not_verified",
            "local_verified",
            "remote_verified",
            "failed",
            "unsupported",
            "unavailable",
            "access_denied",
            "stale"
          ],
          "type": "string"
        }
      },
      "required": [
        "providerId",
        "credentialState",
        "readiness",
        "lifecycleRevision",
        "readinessRevision",
        "observedAt",
        "verificationState",
        "verificationRevision",
        "pendingOperation",
        "cleanupPending",
        "lastDisposition"
      ],
      "type": "object"
    },
    "verifyRequest": {
      "additionalProperties": false,
      "properties": {
        "commandIdentity": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "expectedLifecycleRevision": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "nativeIntentId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "provider": {
          "enum": [
            "openai",
            "deepseek"
          ],
          "type": "string"
        },
        "verificationKind": {
          "enum": [
            "local",
            "remote"
          ],
          "type": "string"
        }
      },
      "required": [
        "provider",
        "expectedLifecycleRevision",
        "verificationKind",
        "commandIdentity",
        "nativeIntentId"
      ],
      "type": "object"
    }
  },
  "$id": "gocode://schemas/provider-credential-enrollment-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "beginRequest": {
      "$ref": "#/$defs/beginRequest"
    },
    "operationResponse": {
      "$ref": "#/$defs/operationResponse"
    },
    "resumeRequest": {
      "$ref": "#/$defs/resumeRequest"
    },
    "statusResponse": {
      "$ref": "#/$defs/statusResponse"
    },
    "verifyRequest": {
      "$ref": "#/$defs/verifyRequest"
    }
  },
  "required": [
    "beginRequest",
    "operationResponse",
    "resumeRequest",
    "statusResponse",
    "verifyRequest"
  ],
  "title": "Protected Provider Credential Enrollment V2",
  "type": "object"
}
