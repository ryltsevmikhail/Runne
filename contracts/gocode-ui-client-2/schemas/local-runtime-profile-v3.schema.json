      "type": "string"
    },
    "certificateSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "daemonInstanceId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "endpoint": {
      "pattern": "^https://(?:127\\.0\\.0\\.1|\\[::1\\]):[1-9][0-9]{0,4}$",
      "type": "string"
    },
    "eventLogLineageId": {
