{
  "$defs": {
    "authenticateRequest": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 43,
          "minLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "challengeId": {
          "maxLength": 22,
          "minLength": 22,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "finalProof": {
          "maxLength": 43,
          "minLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "keyVersion": {
          "const": 1,
          "type": "integer"
        },
        "wireVersion": {
          "const": "3",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "challengeId",
        "finalProof",
        "keyVersion",
        "wireVersion"
      ],
      "type": "object"
    },
    "authenticateResponse": {
      "additionalProperties": false,
      "properties": {
        "expiresAtMonotonicMillis": {
          "minimum": 1,
          "type": "integer"
        },
        "keyVersion": {
          "const": 1,
          "type": "integer"
        },
        "sessionId": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "wireVersion": {
          "const": "3",
          "type": "string"
        }
      },
      "required": [
        "expiresAtMonotonicMillis",
        "keyVersion",
        "sessionId",
        "wireVersion"
      ],
      "type": "object"
    },
    "challengeRequest": {
      "additionalProperties": false,
      "properties": {
        "clientNonce": {
          "maxLength": 43,
          "minLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "expiry": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$",
          "type": "string"
        },
        "keyVersion": {
          "const": 1,
          "type": "integer"
        },
        "notBefore": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$",
          "type": "string"
        },
        "preallocationProof": {
          "maxLength": 43,
          "minLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "wireVersion": {
          "const": "3",
          "type": "string"
        }
      },
      "required": [
        "clientNonce",
        "expiry",
        "keyVersion",
        "notBefore",
        "preallocationProof",
        "wireVersion"
      ],
      "type": "object"
    },
    "challengeResponse": {
      "additionalProperties": false,
      "properties": {
        "challengeId": {
          "maxLength": 22,
          "minLength": 22,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "keyVersion": {
          "const": 1,
          "type": "integer"
        },
        "serverNonce": {
          "maxLength": 43,
          "minLength": 43,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "wireVersion": {
          "const": "3",
          "type": "string"
        }
      },
      "required": [
        "challengeId",
        "keyVersion",
        "serverNonce",
        "wireVersion"
      ],
      "type": "object"
    }
  },
  "$id": "gocode://schemas/local-session-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authenticateRequest": {
      "$ref": "#/$defs/authenticateRequest"
    },
    "authenticateResponse": {
      "$ref": "#/$defs/authenticateResponse"
    },
    "challengeRequest": {
      "$ref": "#/$defs/challengeRequest"
    },
    "challengeResponse": {
      "$ref": "#/$defs/challengeResponse"
    }
  },
  "required": [
    "authenticateRequest",
    "authenticateResponse",
    "challengeRequest",
    "challengeResponse"
  ],
  "title": "Local Session V2 Golden Exchange",
  "type": "object"
}
