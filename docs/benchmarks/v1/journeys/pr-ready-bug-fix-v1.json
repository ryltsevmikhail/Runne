{
  "schema_version": "runne.benchmark.journey/1",
  "journey_id": "pr_ready_bug_fix",
  "revision": 1,
  "title": "PR-ready bug fix",
  "objective": "Produce a minimal reviewable patch that reproduces and fixes one bounded defect without unrelated changes.",
  "scope": {"max_files_changed": 12, "max_changed_lines": 600, "network_allowed": false, "new_dependencies_allowed": false},
  "verifier_contract": {"kind": "machine", "requires_clean_exit": true, "requires_targeted_tests": true, "requires_diff_check": true},
  "required_checks": ["reproduction_before", "targeted_regression_after", "required_tests_pass", "diff_within_scope"],
  "success_conditions": ["all_required_checks_pass", "process_exit_zero", "diff_within_declared_scope", "no_unresolved_effect"],
  "failure_conditions": ["required_check_failed", "process_exit_nonzero", "scope_exceeded", "effect_or_recovery_failed"]
}
