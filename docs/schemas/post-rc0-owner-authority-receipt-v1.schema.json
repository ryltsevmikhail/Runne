{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.post-rc0-owner-authority-receipt/1",
  "title": "GOCODE Post-RC0 Owner Authority Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "runtime_adr_document_sha256", "desktop_adr_document_sha256", "shared_decision_payload_sha256", "shared_decision_schema_sha256", "runtime_owner_acceptance_envelope_sha256", "desktop_owner_acceptance_envelope_sha256", "runtime_owner_acceptance", "desktop_owner_acceptance", "adjunct_trust_registry_envelope_sha256", "adjunct_trust_registry_payload_sha256", "issued_at", "expires_at", "revocation_epoch"],
  "properties": {
    "schema_version": {"const": "gocode.rc0.post-rc0-owner-authority-receipt/1"}, "repository_id": {"const": "gocode"}, "runtime_adr_document_sha256": {"$ref": "#/$defs/sha256"}, "desktop_adr_document_sha256": {"$ref": "#/$defs/sha256"}, "shared_decision_payload_sha256": {"$ref": "#/$defs/sha256"}, "shared_decision_schema_sha256": {"$ref": "#/$defs/sha256"}, "runtime_owner_acceptance_envelope_sha256": {"$ref": "#/$defs/sha256"}, "desktop_owner_acceptance_envelope_sha256": {"$ref": "#/$defs/sha256"}, "runtime_owner_acceptance": {"$ref": "#/$defs/acceptance"}, "desktop_owner_acceptance": {"$ref": "#/$defs/acceptance"}, "adjunct_trust_registry_envelope_sha256": {"$ref": "#/$defs/sha256"}, "adjunct_trust_registry_payload_sha256": {"$ref": "#/$defs/sha256"}, "issued_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/timestamp"}, "revocation_epoch": {"type": "integer", "minimum": 0}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "identifier": {"type": "string", "minLength": 1, "maxLength": 4096}, "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"}, "acceptance": {"type": "object", "additionalProperties": false, "required": ["owner_domain", "owner_subject_id", "owner_controlling_account_id", "owner_delegated_session_id", "owner_lane_id", "adr_document_sha256", "shared_decision_payload_sha256", "shared_decision_schema_sha256", "accepted_at", "revocation_epoch"], "properties": {"owner_domain": {"enum": ["runtime", "desktop"]}, "owner_subject_id": {"$ref": "#/$defs/identifier"}, "owner_controlling_account_id": {"$ref": "#/$defs/identifier"}, "owner_delegated_session_id": {"$ref": "#/$defs/identifier"}, "owner_lane_id": {"$ref": "#/$defs/identifier"}, "adr_document_sha256": {"$ref": "#/$defs/sha256"}, "shared_decision_payload_sha256": {"$ref": "#/$defs/sha256"}, "shared_decision_schema_sha256": {"$ref": "#/$defs/sha256"}, "accepted_at": {"$ref": "#/$defs/timestamp"}, "revocation_epoch": {"type": "integer", "minimum": 0}}}}
}
