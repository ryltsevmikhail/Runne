{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.post-rc0-adjunct-trust-schema-registry/1",
  "title": "GOCODE Post-RC0 Adjunct Trust Schema Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "registry_revision", "adjunct_schema_digests", "role_principal_constraints", "issued_at", "expires_at", "revocation_epoch"],
  "properties": {
    "schema_version": {"const": "gocode.rc0.post-rc0-adjunct-trust-schema-registry/1"}, "repository_id": {"const": "gocode"}, "registry_revision": {"type": "integer", "minimum": 1}, "adjunct_schema_digests": {"type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": {"$ref": "#/$defs/schema_digest"}}, "role_principal_constraints": {"type": "array", "minItems": 3, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/role_principal"}}, "issued_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/timestamp"}, "revocation_epoch": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "identifier": {"type": "string", "minLength": 1, "maxLength": 4096}, "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"},
    "schema_digest": {"type": "object", "additionalProperties": false, "required": ["schema_id", "schema_sha256"], "properties": {"schema_id": {"enum": ["gocode.external-signed-envelope/1", "gocode.governance.platform-decision-acceptance/1", "gocode.rc0.platform-scope-mapping-policy/1", "gocode.rc0.qualified-declaration/1", "gocode.rc0.platform-scope-attestation/1", "gocode.rc0.artifact-measurement-record/1", "gocode.rc0.native-host-evidence-record/1", "gocode.rc0.profile-evidence-record/1", "gocode.rc0.canary-evidence-record/1", "gocode.rc0.policy-activation-intent/1", "gocode.rc0.policy-acceptance-receipt/1", "gocode.rc0.policy-activation-snapshot/1", "gocode.rc0.platform-qualified-subject/1", "gocode.release.platform-qualification-matrix/2", "gocode.rc0.post-rc0-owner-authority-receipt/1", "gocode.v1-platform-scope-claim-migration/1", "gocode.rc0.post-rc0-platform-composed-universe/1", "gocode.rc0.post-rc0-reconciliation-receipt/1"]}, "schema_sha256": {"$ref": "#/$defs/sha256"}}},
    "principal": {"type": "object", "additionalProperties": false, "required": ["subject_id", "controlling_account_id", "delegated_session_id", "lane_id"], "properties": {"subject_id": {"$ref": "#/$defs/identifier"}, "controlling_account_id": {"$ref": "#/$defs/identifier"}, "delegated_session_id": {"$ref": "#/$defs/identifier"}, "lane_id": {"$ref": "#/$defs/identifier"}}},
    "role_principal": {"type": "object", "additionalProperties": false, "required": ["role_id", "principal"], "properties": {"role_id": {"enum": ["POST_RC0_ADJUNCT_REGISTRY_AUTHORITY", "POST_RC0_G1_RECEIPT_AUTHORITY", "POST_RC0_RECONCILIATION_AUTHORITY", "runtime_platform_owner", "desktop_platform_owner", "mapping_policy_authority", "rc0_qualification_reporter", "rc0_qualification_declarer", "artifact_classifier_a", "artifact_classifier_b", "native_host_attestor", "external_canary_operator", "qualification_aggregator", "policy_authority"]}, "principal": {"$ref": "#/$defs/principal"}}}
  }
}
