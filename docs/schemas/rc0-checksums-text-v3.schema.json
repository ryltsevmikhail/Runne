{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.rc0.schema.checksums-text/3",
  "title": "RUNNE RC0 Canonical Checksums Text Model V3",
  "description": "Closed normalized model returned by the strict checksums.txt parser.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "repository_id", "candidate_source_revision", "evidence_attempt_id", "policy_digest", "artifacts"],
  "properties": {
    "schema_id": {"const": "runne.rc0.schema.checksums-text/3"},
    "repository_id": {"type": "string", "minLength": 1},
    "candidate_source_revision": {"$ref": "#/$defs/gitSha"},
    "evidence_attempt_id": {"$ref": "#/$defs/uuidV7"},
    "policy_digest": {"$ref": "#/$defs/sha256"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuidV7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
      }
    },
    "portablePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*]).+$"}
  }
}
