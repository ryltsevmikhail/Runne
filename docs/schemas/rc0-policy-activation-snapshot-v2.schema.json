{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.rc0.policy-activation-snapshot/2",
  "title": "RUNNE Solo Owner Policy Activation Snapshot V2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "repository_id", "project_owner_authority_receipt_sha256", "mapping_policy_envelope_sha256", "activation_intent_envelope_sha256", "activation_snapshot_envelope_sha256", "activation_epoch", "predecessor_activation_snapshot_envelope_sha256"],
  "properties": {
    "schema_version": {"const": "runne.rc0.policy-activation-snapshot/2"}, "repository_id": {"const": "runne"},
    "project_owner_authority_receipt_sha256": {"$ref": "#/$defs/sha256"}, "mapping_policy_envelope_sha256": {"$ref": "#/$defs/sha256"}, "activation_intent_envelope_sha256": {"$ref": "#/$defs/sha256"}, "activation_snapshot_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "activation_epoch": {"type": "integer", "minimum": 1}, "predecessor_activation_snapshot_envelope_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  }, "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
