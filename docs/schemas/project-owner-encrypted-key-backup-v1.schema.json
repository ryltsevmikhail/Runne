{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.project-owner.encrypted-key-backup/1",
  "title": "RUNNE Project Owner Encrypted Key Backup V1",
  "description": "Public encrypted-backup metadata. The complete metadata is authenticated data. Excluded: plaintext, private keys, passphrases, username, email, hostname, account, session, lane, PID, absolute paths, document bodies and private comments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "key_id", "key_epoch", "key_fingerprint", "kdf", "salt", "nonce", "ciphertext"],
  "properties": {
    "schema_version": {"const": "runne.project-owner.encrypted-key-backup/1"},
    "repository_id": {"const": "runne"},
    "key_id": {"$ref": "#/$defs/sha256"},
    "key_epoch": {"type": "integer", "minimum": 1},
    "key_fingerprint": {"$ref": "#/$defs/sha256"},
    "kdf": {"$ref": "#/$defs/kdf"},
    "salt": {"$ref": "#/$defs/salt"},
    "nonce": {"$ref": "#/$defs/nonce"},
    "ciphertext": {"$ref": "#/$defs/ciphertext"}
  },
  "$defs": {
    "base64url": {"type": "string", "minLength": 1, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"},
    "salt": {"$ref": "#/$defs/base64url", "minLength": 22, "maxLength": 86, "description": "Unpadded base64url encoding of 16 through 64 random salt bytes."},
    "nonce": {"$ref": "#/$defs/base64url", "minLength": 32, "maxLength": 32},
    "ciphertext": {"$ref": "#/$defs/base64url", "minLength": 64, "maxLength": 64, "description": "Unpadded base64url encoding of exactly 32 encrypted seed bytes plus a 16-byte AEAD tag."},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "memory_kib", "iterations", "parallelism"],
      "properties": {
        "algorithm": {"const": "Argon2id"},
        "memory_kib": {"type": "integer", "minimum": 65536, "maximum": 262144},
        "iterations": {"type": "integer", "minimum": 3, "maximum": 10},
        "parallelism": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    }
  }
}
