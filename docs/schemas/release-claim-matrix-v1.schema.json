{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runne.dev/schemas/release-claim-matrix-v1.schema.json",
  "title": "RUNNE Release Claim Matrix V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_sha256", "claims"],
  "properties": {
    "schema_version": {"const": "release-claim-matrix.v1"},
    "subject_sha256": {"$ref": "#/$defs/sha256"},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "disposition", "blocker_code", "subject_sha256"], "properties": {"claim_id": {"enum": ["operational_telemetry", "macos_developer_id_signing", "notarization_stapling", "live_openai_l4", "tool_process_execution", "mcp_fixture_mode", "mcp_external_activation", "bundled_runtime", "external_daemon", "v1_v2_compatibility", "recovery_upgrade", "install_upgrade_rollback", "linux_qualification", "macos_qualification", "windows_qualification", "pinned_lane", "msrv_lane", "dependency_inventory", "license", "advisory", "sbom", "checksums"]}, "disposition": {"enum": ["VERIFIED", "BLOCKED", "BLOCKED_CREDENTIALS", "BLOCKED_PLATFORM", "BLOCKED_HOSTED_EVIDENCE", "NOT_RUN", "NOT_ACTIVATED", "UNSUPPORTED", "DISABLED_BY_POLICY"]}, "blocker_code": {"type": ["string", "null"], "enum": ["EvidenceMissing", "SigningBlockedCredentials", "NATIVE_SANDBOX_NOT_QUALIFIED", "ArtifactMissing", "HostedLaneMissing", "DependencyInventoryIncomplete", "LicenseEvidenceMissing", "AdvisoryReportMissing", "SbomIncomplete", null]}, "subject_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
