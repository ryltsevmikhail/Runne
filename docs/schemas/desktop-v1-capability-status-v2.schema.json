{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gocode.dev/schemas/desktop-v1-capability-status-v2.schema.json",
  "title": "GOCODE Desktop V1 Source-Bound Capability Status V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "definition_sha256", "canonical_source_content_sha256", "recorded_at", "contract", "selector_list_sha256", "toolchain_identity", "runner_identity", "evidence_refs", "platforms", "gates", "capabilities"],
  "properties": {
    "schema_version": {"const": "desktop-v1-capability-status.v2"},
    "manifest_id": {"const": "desktop-v1"},
    "definition_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_source_content_sha256": {"$ref": "#/$defs/sha256"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "contract": {"$ref": "#/$defs/contract"},
    "selector_list_sha256": {"$ref": "#/$defs/sha256"},
    "toolchain_identity": {"$ref": "#/$defs/toolchain_identity"},
    "runner_identity": {"$ref": "#/$defs/runner_identity"},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/platform_status"}},
    "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/gate_status"}},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability_status"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "contract": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_sha256", "bundle_sha256"], "properties": {"profile_id": {"const": "gocode-ui-client/2"}, "profile_sha256": {"$ref": "#/$defs/sha256"}, "bundle_sha256": {"$ref": "#/$defs/sha256"}}},
    "toolchain_identity": {"type": "object", "additionalProperties": false, "required": ["status", "name", "version"], "properties": {"status": {"enum": ["recorded", "not_recorded"]}, "name": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]}}},
    "runner_identity": {"type": "object", "additionalProperties": false, "required": ["status", "runner_id", "image_sha256"], "properties": {"status": {"enum": ["recorded", "not_recorded"]}, "runner_id": {"type": ["string", "null"]}, "image_sha256": {"$ref": "#/$defs/optional_sha256"}}},
    "evidence_ref": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "platform_status": {"type": "object", "additionalProperties": false, "required": ["platform_id", "disposition", "blocker_code"], "properties": {"platform_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"}, "disposition": {"enum": ["verified", "not_recorded", "blocked", "unsupported"]}, "blocker_code": {"type": ["string", "null"], "enum": ["EVIDENCE_NOT_RECORDED", "WINDOWS_SECURE_IDENTITY_UNVERIFIED", "WINDOWS_PROTECTED_LAUNCH_UNVERIFIED", "LINUX_SECURE_IDENTITY_UNVERIFIED", "LINUX_PROTECTED_LAUNCH_UNVERIFIED", "MACOS_STAGED_DAEMON_IDENTITY_UNVERIFIED", "RUNNER_TRUST_UNVERIFIED", null]}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["subject_sha256", "predicate_sha256"], "properties": {"subject_sha256": {"$ref": "#/$defs/sha256"}, "predicate_sha256": {"$ref": "#/$defs/sha256"}}},
    "gate_status": {"type": "object", "additionalProperties": false, "required": ["gate_id", "disposition", "blocker_code"], "properties": {"gate_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"}, "disposition": {"enum": ["verified", "not_recorded", "blocked"]}, "blocker_code": {"type": ["string", "null"], "enum": ["EVIDENCE_NOT_RECORDED", null]}, "evidence_ref": {"type": "string", "minLength": 1}, "provenance": {"$ref": "#/$defs/provenance"}}, "allOf": [{"if": {"properties": {"disposition": {"const": "verified"}}, "required": ["disposition"]}, "then": {"required": ["evidence_ref", "provenance"], "properties": {"blocker_code": {"const": null}}}}]},
    "capability_status": {"type": "object", "additionalProperties": false, "required": ["capability_id", "disposition", "blocker_code"], "properties": {"capability_id": {"type": "string", "pattern": "^CAP-[A-Z]{3}$"}, "disposition": {"enum": ["verified", "blocked"]}, "blocker_code": {"type": ["string", "null"], "enum": ["EVIDENCE_NOT_RECORDED", null]}}}
  }
}
