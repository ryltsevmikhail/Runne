{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.project-owner.trust-config/1",
  "title": "GOCODE Project Owner Trust Config V1",
  "description": "Public active trust configuration; it contains no private key material or local identity data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "role", "epoch", "key_id", "public_key", "schema_digests", "proof_of_possession", "predecessor"],
  "properties": {
    "schema_version": {"const": "gocode.project-owner.trust-config/1"},
    "repository_id": {"const": "gocode"},
    "role": {"const": "PROJECT_OWNER"},
    "epoch": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "key_id": {"$ref": "#/$defs/sha256"},
    "public_key": {"$ref": "#/$defs/public_key"},
    "schema_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/schema_digest"}},
    "proof_of_possession": {"$ref": "#/$defs/signature"},
    "predecessor": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"epoch": {"const": 1}}, "required": ["epoch"]},
      "then": {"properties": {"predecessor": {"type": "null"}}}
    },
    {
      "if": {"properties": {"epoch": {"minimum": 2}}, "required": ["epoch"]},
      "then": {"properties": {"predecessor": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    }
  ],
  "$defs": {
    "base64url": {"type": "string", "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"},
    "public_key": {"$ref": "#/$defs/base64url", "minLength": 43, "maxLength": 43},
    "signature": {"$ref": "#/$defs/base64url", "minLength": 86, "maxLength": 86},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_sha256"],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^gocode\\.[a-z0-9.-]+/[0-9]+$"},
        "schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
