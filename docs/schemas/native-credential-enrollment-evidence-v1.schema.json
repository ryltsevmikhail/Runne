{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode://schemas/native-credential-enrollment-evidence-v1",
  "title": "Native Credential Enrollment Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "rows"],
  "properties": {
    "schema_version": {"const": "native-credential-enrollment-evidence.v1"},
    "platform": {"enum": ["macos", "linux", "windows"]},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"oneOf": [{"$ref": "#/$defs/macos_row"}, {"$ref": "#/$defs/linux_row"}, {"$ref": "#/$defs/windows_row"}]}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"platform": {"const": "macos"}}},
      "then": {"properties": {"rows": {"minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/macos_row"}}}}
    },
    {
      "if": {"properties": {"platform": {"const": "linux"}}},
      "then": {"properties": {"rows": {"minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/linux_row"}}}}
    },
    {
      "if": {"properties": {"platform": {"const": "windows"}}},
      "then": {"properties": {"rows": {"minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/windows_row"}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["verified", "unsupported"]},
        "network_attempts": {"type": "integer", "minimum": 0},
        "local_verification": {"enum": ["verified"]},
        "retry_count": {"type": "integer", "minimum": 0}
      }
    },
    "macos_verified_selector": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "verified"}}},
    "macos_local_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "network_attempts"],
      "properties": {"status": {"const": "verified"}, "network_attempts": {"type": "integer", "const": 0}}
    },
    "macos_remote_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "local_verification", "retry_count"],
      "properties": {"status": {"enum": ["verified", "unsupported"]}, "local_verification": {"const": "verified"}, "retry_count": {"type": "integer", "const": 0}}
    },
    "macos_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "os_version", "disposition", "tuple", "signing", "runner", "native_store", "artifact_scan", "selectors", "deployment"],
      "properties": {
        "platform": {"const": "macos"},
        "architecture": {"const": "arm64"},
        "os_version": {"type": "string", "pattern": "^(1[3-9]|[2-9][0-9])(?:\\.[0-9]{1,3}){0,2}(?![\\s\\S])"},
        "disposition": {"const": "verified"},
        "tuple": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop_sha256", "writer_sha256", "daemon_sha256", "service_sha256", "launch_agent_plist_sha256", "entitlements_sha256", "provisioning_sha256", "protocol_sha256", "contract_sha256", "candidate_sha256", "tuple_sha256", "release_tuple_v3_sha256", "deployment_sha256", "desktop_code_identity_sha256", "writer_code_identity_sha256", "daemon_code_identity_sha256", "service_code_identity_sha256"],
          "properties": {
            "desktop_sha256": {"$ref": "#/$defs/sha256"},
            "writer_sha256": {"$ref": "#/$defs/sha256"},
            "daemon_sha256": {"$ref": "#/$defs/sha256"},
            "service_sha256": {"$ref": "#/$defs/sha256"},
            "launch_agent_plist_sha256": {"$ref": "#/$defs/sha256"},
            "entitlements_sha256": {"$ref": "#/$defs/sha256"},
            "provisioning_sha256": {"$ref": "#/$defs/sha256"},
            "protocol_sha256": {"$ref": "#/$defs/sha256"},
            "contract_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "tuple_sha256": {"$ref": "#/$defs/sha256"},
            "release_tuple_v3_sha256": {"$ref": "#/$defs/sha256"},
            "deployment_sha256": {"$ref": "#/$defs/sha256"},
            "desktop_code_identity_sha256": {"$ref": "#/$defs/sha256"},
            "writer_code_identity_sha256": {"$ref": "#/$defs/sha256"},
            "daemon_code_identity_sha256": {"$ref": "#/$defs/sha256"},
            "service_code_identity_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "notarized", "ad_hoc", "team_id", "code_identifiers", "application_identifiers"],
          "properties": {
            "profile": {"const": "developer_id"},
            "notarized": {"const": true},
            "ad_hoc": {"const": false},
            "team_id": {"const": "758F9Z45SR"},
            "code_identifiers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "writer", "daemon", "service"],
              "properties": {"desktop": {"const": "com.runne.desktop"}, "writer": {"const": "runne"}, "daemon": {"const": "runned"}, "service": {"const": "com.runne.credential-service"}}
            },
            "application_identifiers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "service"],
              "properties": {"desktop": {"const": "758F9Z45SR.com.runne.desktop"}, "service": {"const": "758F9Z45SR.com.runne.credential-service"}}
            }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_run_id", "attestation_verified", "freshness_verified", "isolated_disposable_user", "icloud_data_present", "user_keychain_data_present"],
          "properties": {
            "workflow_run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"},
            "attestation_verified": {"const": true},
            "freshness_verified": {"const": true},
            "isolated_disposable_user": {"const": true},
            "icloud_data_present": {"const": false},
            "user_keychain_data_present": {"const": false}
          }
        },
        "native_store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access_group", "data_protection_keychain", "accessibility", "synchronizable", "file_keychain", "environment_keychain", "ksec_use_keychain", "legacy_acl"],
          "properties": {
            "access_group": {"const": "758F9Z45SR.com.runne.credential-service"},
            "data_protection_keychain": {"const": true},
            "accessibility": {"const": "when_unlocked_this_device_only"},
            "synchronizable": {"const": false},
            "file_keychain": {"const": false},
            "environment_keychain": {"const": false},
            "ksec_use_keychain": {"const": false},
            "legacy_acl": {"const": false}
          }
        },
        "artifact_scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files_scanned", "sensitive_value_matches"],
          "properties": {"files_scanned": {"type": "integer", "minimum": 1, "maximum": 1000000}, "sensitive_value_matches": {"const": 0}}
        },
        "selectors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_only_mismatch_denied", "ad_hoc_signature_denied", "clean_install", "crash_recovery", "duplicate_version_denied", "hardlink_denied", "keychain_executable_acl_denied", "kill_after_lifecycle_cas", "kill_after_native_effect", "kill_after_readback", "kill_after_reply", "kill_after_service_consume", "kill_before_lifecycle_cas", "kill_before_native_effect", "kill_before_readback", "kill_before_reply", "kill_before_service_consume", "local_verify_no_network", "mixed_child_manifest_denied", "n_to_n_plus_1", "package_skew_denied", "pair_create_readback", "pid_reuse_denied", "post_spawn_codesign_skew_denied", "post_spawn_executable_image_skew_denied", "remote_verify_after_local", "replay_denied", "revoke_fence_delete", "rollback", "rotation", "service_restart_persistence", "standalone_daemon_denied", "standalone_writer_denied", "stored_attributes_verified", "symlink_denied", "third_process_broker_denied", "unsigned_package_denied", "wrong_peer_denied", "duplicate_request_denied", "kill_desktop_process", "kill_registration_ack_loss", "kill_runtime_process", "kill_service_launchd_restart", "kill_writer_process", "runtime_restart_old_session_denied", "same_uid_native_delete_denied", "same_uid_native_find_denied", "same_uid_native_read_denied", "same_uid_native_update_denied", "terminal_exact_namespace_cleanup", "wrong_desktop_endpoint_peer_denied", "wrong_runtime_endpoint_peer_denied", "wrong_service_peer_denied", "wrong_writer_endpoint_peer_denied"],
          "properties": {
            "account_only_mismatch_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "ad_hoc_signature_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "clean_install": {"$ref": "#/$defs/macos_verified_selector"},
            "crash_recovery": {"$ref": "#/$defs/macos_verified_selector"},
            "duplicate_version_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "hardlink_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "keychain_executable_acl_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_after_lifecycle_cas": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_after_native_effect": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_after_readback": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_after_reply": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_after_service_consume": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_before_lifecycle_cas": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_before_native_effect": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_before_readback": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_before_reply": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_before_service_consume": {"$ref": "#/$defs/macos_verified_selector"},
            "local_verify_no_network": {"$ref": "#/$defs/macos_local_selector"},
            "mixed_child_manifest_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "n_to_n_plus_1": {"$ref": "#/$defs/macos_verified_selector"},
            "package_skew_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "pair_create_readback": {"$ref": "#/$defs/macos_verified_selector"},
            "pid_reuse_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "post_spawn_codesign_skew_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "post_spawn_executable_image_skew_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "remote_verify_after_local": {"$ref": "#/$defs/macos_remote_selector"},
            "replay_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "revoke_fence_delete": {"$ref": "#/$defs/macos_verified_selector"},
            "rollback": {"$ref": "#/$defs/macos_verified_selector"},
            "rotation": {"$ref": "#/$defs/macos_verified_selector"},
            "service_restart_persistence": {"$ref": "#/$defs/macos_verified_selector"},
            "standalone_daemon_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "standalone_writer_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "stored_attributes_verified": {"$ref": "#/$defs/macos_verified_selector"},
            "symlink_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "third_process_broker_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "unsigned_package_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "wrong_peer_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "duplicate_request_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_desktop_process": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_registration_ack_loss": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_runtime_process": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_service_launchd_restart": {"$ref": "#/$defs/macos_verified_selector"},
            "kill_writer_process": {"$ref": "#/$defs/macos_verified_selector"},
            "runtime_restart_old_session_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "same_uid_native_delete_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "same_uid_native_find_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "same_uid_native_read_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "same_uid_native_update_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "terminal_exact_namespace_cleanup": {"$ref": "#/$defs/macos_verified_selector"},
            "wrong_desktop_endpoint_peer_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "wrong_runtime_endpoint_peer_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "wrong_service_peer_denied": {"$ref": "#/$defs/macos_verified_selector"},
            "wrong_writer_endpoint_peer_denied": {"$ref": "#/$defs/macos_verified_selector"}
          }
        },
        "deployment": {
          "const": {
            "release_tuple_version": 3,
            "helper_bundle_identifier": "com.runne.credential-service",
            "helper_executable": "runne-credential-service",
            "launch_agent_label": "com.runne.credential-service",
            "bundle_program": "Contents/Library/Helpers/RunneCredentialService.app/Contents/MacOS/runne-credential-service",
            "keep_alive": false,
            "run_at_load": false,
            "mach_services": {"com.runne.credential-service.desktop.v1": true, "com.runne.credential-service.runtime.v1": true, "com.runne.credential-service.writer.v1": true},
            "entitlements": {
              "desktop": {
                "com.apple.application-identifier": "758F9Z45SR.com.runne.desktop",
                "com.apple.developer.team-identifier": "758F9Z45SR",
                "keychain-access-groups": ["758F9Z45SR.com.runne.desktop"]
              },
              "writer": {},
              "daemon": {},
              "service": {
                "com.apple.application-identifier": "758F9Z45SR.com.runne.credential-service",
                "com.apple.developer.team-identifier": "758F9Z45SR",
                "keychain-access-groups": ["758F9Z45SR.com.runne.credential-service"]
              }
            },
            "transport": "nsxpc_role_listeners",
            "magic": "RNCRED01",
            "registration_version": 1,
            "provider_frame_version": 2,
            "runtime_envelope_version": 2,
            "runtime_mac_version": 3,
            "provisioning": "distribution_verified",
            "package": "immutable_installed"
          }
        }
      }
    },
    "linux_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "distribution", "architecture", "package_format", "disposition", "isolation_class", "tuple", "native_store", "runner", "selectors"],
      "properties": {
        "platform": {"const": "linux"},
        "distribution": {"const": "ubuntu-22.04"},
        "architecture": {"const": "x86_64"},
        "package_format": {"enum": ["appimage", "deb"]},
        "disposition": {"const": "verified"},
        "isolation_class": {"const": "owner_session_scoped"},
        "tuple": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop_sha256", "writer_sha256", "daemon_sha256", "contract_sha256", "candidate_sha256", "tuple_sha256"],
          "properties": {
            "desktop_sha256": {"$ref": "#/$defs/sha256"},
            "writer_sha256": {"$ref": "#/$defs/sha256"},
            "daemon_sha256": {"$ref": "#/$defs/sha256"},
            "contract_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "tuple_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "native_store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_dbus", "keyring"],
          "properties": {
            "session_dbus": {"const": "verified"},
            "keyring": {"const": "verified"}
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_run_id", "attestation_verified"],
          "properties": {
            "workflow_run_id": {"type": "string", "minLength": 1},
            "attestation_verified": {"const": true}
          }
        },
        "selectors": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/selector"}
        }
      }
    },
    "windows_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "version", "architecture", "package_format", "disposition", "isolation_class", "tuple", "native_store", "runner", "selectors"],
      "properties": {
        "platform": {"const": "windows"},
        "version": {"const": "10-22H2"},
        "architecture": {"const": "x86_64"},
        "package_format": {"const": "nsis"},
        "disposition": {"const": "verified"},
        "isolation_class": {"const": "owner_session_scoped"},
        "tuple": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop_sha256", "writer_sha256", "daemon_sha256", "contract_sha256", "candidate_sha256", "tuple_sha256"],
          "properties": {
            "desktop_sha256": {"$ref": "#/$defs/sha256"},
            "writer_sha256": {"$ref": "#/$defs/sha256"},
            "daemon_sha256": {"$ref": "#/$defs/sha256"},
            "contract_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "tuple_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "native_store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credential_manager", "logon_session"],
          "properties": {
            "credential_manager": {"const": "verified"},
            "logon_session": {"const": "verified"}
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_run_id", "attestation_verified"],
          "properties": {
            "workflow_run_id": {"type": "string", "minLength": 1},
            "attestation_verified": {"const": true}
          }
        },
        "selectors": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/selector"}
        }
      }
    }
  }
}
