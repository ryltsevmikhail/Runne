{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode://schemas/native-credential-enrollment-evidence-v1",
  "title": "Native Credential Enrollment Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "rows"],
  "properties": {
    "schema_version": {"const": "native-credential-enrollment-evidence.v1"},
    "platform": {"enum": ["macos", "linux", "windows"]},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"oneOf": [{"$ref": "#/$defs/macos_row"}, {"$ref": "#/$defs/linux_row"}, {"$ref": "#/$defs/windows_row"}]}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"platform": {"const": "macos"}}},
      "then": {"properties": {"rows": {"minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/macos_row"}}}}
    },
    {
      "if": {"properties": {"platform": {"const": "linux"}}},
      "then": {"properties": {"rows": {"minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/linux_row"}}}}
    },
    {
      "if": {"properties": {"platform": {"const": "windows"}}},
      "then": {"properties": {"rows": {"minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/windows_row"}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["verified", "unsupported"]},
        "network_attempts": {"type": "integer", "minimum": 0},
        "local_verification": {"enum": ["verified"]},
        "retry_count": {"type": "integer", "minimum": 0}
      }
    },
    "macos_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "os_version", "disposition", "tuple", "signing", "runner", "native_store", "artifact_scan", "selectors"],
      "properties": {
        "platform": {"const": "macos"},
        "architecture": {"const": "arm64"},
        "os_version": {"type": "string", "pattern": "^(1[3-9]|[2-9][0-9])(?:\\.[0-9]+){0,2}$"},
        "disposition": {"const": "verified"},
        "tuple": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop_sha256", "writer_sha256", "daemon_sha256", "service_sha256", "launch_agent_plist_sha256", "entitlements_sha256", "provisioning_sha256", "protocol_sha256", "contract_sha256", "candidate_sha256", "tuple_sha256"],
          "properties": {
            "desktop_sha256": {"$ref": "#/$defs/sha256"},
            "writer_sha256": {"$ref": "#/$defs/sha256"},
            "daemon_sha256": {"$ref": "#/$defs/sha256"},
            "service_sha256": {"$ref": "#/$defs/sha256"},
            "launch_agent_plist_sha256": {"$ref": "#/$defs/sha256"},
            "entitlements_sha256": {"$ref": "#/$defs/sha256"},
            "provisioning_sha256": {"$ref": "#/$defs/sha256"},
            "protocol_sha256": {"$ref": "#/$defs/sha256"},
            "contract_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "tuple_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "notarized", "ad_hoc", "team_id", "code_identifiers", "application_identifiers"],
          "properties": {
            "profile": {"const": "developer_id"},
            "notarized": {"const": true},
            "ad_hoc": {"const": false},
            "team_id": {"const": "758F9Z45SR"},
            "code_identifiers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "writer", "daemon", "service"],
              "properties": {
                "desktop": {"const": "com.runne.desktop"},
                "writer": {"const": "runne"},
                "daemon": {"const": "runned"},
                "service": {"const": "com.runne.credential-service"}
              }
            },
            "application_identifiers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "service"],
              "properties": {
                "desktop": {"const": "758F9Z45SR.com.runne.desktop"},
                "service": {"const": "758F9Z45SR.com.runne.credential-service"}
              }
            }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_run_id", "attestation_verified", "freshness_verified", "isolated_disposable_user", "icloud_data_present", "user_keychain_data_present"],
          "properties": {
            "workflow_run_id": {"type": "string", "minLength": 1},
            "attestation_verified": {"const": true},
            "freshness_verified": {"const": true},
            "isolated_disposable_user": {"const": true},
            "icloud_data_present": {"const": false},
            "user_keychain_data_present": {"const": false}
          }
        },
        "native_store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["access_group", "data_protection_keychain", "accessibility", "synchronizable", "file_keychain", "environment_keychain", "ksec_use_keychain", "legacy_acl"],
          "properties": {
            "access_group": {"const": "758F9Z45SR.com.runne.credential-service"},
            "data_protection_keychain": {"const": true},
            "accessibility": {"const": "after_first_unlock_this_device_only"},
            "synchronizable": {"const": false},
            "file_keychain": {"const": false},
            "environment_keychain": {"const": false},
            "ksec_use_keychain": {"const": false},
            "legacy_acl": {"const": false}
          }
        },
        "artifact_scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files_scanned", "sensitive_value_matches"],
          "properties": {
            "files_scanned": {"type": "integer", "minimum": 1},
            "sensitive_value_matches": {"const": 0}
          }
        },
        "selectors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_only_mismatch_denied", "ad_hoc_signature_denied", "clean_install", "crash_recovery", "duplicate_version_denied", "hardlink_denied", "keychain_executable_acl_denied", "kill_after_lifecycle_cas", "kill_after_native_effect", "kill_after_readback", "kill_after_reply", "kill_after_service_consume", "kill_before_lifecycle_cas", "kill_before_native_effect", "kill_before_readback", "kill_before_reply", "kill_before_service_consume", "local_verify_no_network", "mixed_child_manifest_denied", "n_to_n_plus_1", "package_skew_denied", "pair_create_readback", "pid_reuse_denied", "post_spawn_codesign_skew_denied", "post_spawn_executable_image_skew_denied", "remote_verify_after_local", "replay_denied", "revoke_fence_delete", "rollback", "rotation", "service_restart_persistence", "standalone_daemon_denied", "standalone_writer_denied", "stored_attributes_verified", "symlink_denied", "third_process_broker_denied", "unsigned_package_denied", "wrong_peer_denied"],
          "properties": {
            "account_only_mismatch_denied": {"$ref": "#/$defs/selector"},
            "ad_hoc_signature_denied": {"$ref": "#/$defs/selector"},
            "clean_install": {"$ref": "#/$defs/selector"},
            "crash_recovery": {"$ref": "#/$defs/selector"},
            "duplicate_version_denied": {"$ref": "#/$defs/selector"},
            "hardlink_denied": {"$ref": "#/$defs/selector"},
            "keychain_executable_acl_denied": {"$ref": "#/$defs/selector"},
            "kill_after_lifecycle_cas": {"$ref": "#/$defs/selector"},
            "kill_after_native_effect": {"$ref": "#/$defs/selector"},
            "kill_after_readback": {"$ref": "#/$defs/selector"},
            "kill_after_reply": {"$ref": "#/$defs/selector"},
            "kill_after_service_consume": {"$ref": "#/$defs/selector"},
            "kill_before_lifecycle_cas": {"$ref": "#/$defs/selector"},
            "kill_before_native_effect": {"$ref": "#/$defs/selector"},
            "kill_before_readback": {"$ref": "#/$defs/selector"},
            "kill_before_reply": {"$ref": "#/$defs/selector"},
            "kill_before_service_consume": {"$ref": "#/$defs/selector"},
            "local_verify_no_network": {"$ref": "#/$defs/selector"},
            "mixed_child_manifest_denied": {"$ref": "#/$defs/selector"},
            "n_to_n_plus_1": {"$ref": "#/$defs/selector"},
            "package_skew_denied": {"$ref": "#/$defs/selector"},
            "pair_create_readback": {"$ref": "#/$defs/selector"},
            "pid_reuse_denied": {"$ref": "#/$defs/selector"},
            "post_spawn_codesign_skew_denied": {"$ref": "#/$defs/selector"},
            "post_spawn_executable_image_skew_denied": {"$ref": "#/$defs/selector"},
            "remote_verify_after_local": {"$ref": "#/$defs/selector"},
            "replay_denied": {"$ref": "#/$defs/selector"},
            "revoke_fence_delete": {"$ref": "#/$defs/selector"},
            "rollback": {"$ref": "#/$defs/selector"},
            "rotation": {"$ref": "#/$defs/selector"},
            "service_restart_persistence": {"$ref": "#/$defs/selector"},
            "standalone_daemon_denied": {"$ref": "#/$defs/selector"},
            "standalone_writer_denied": {"$ref": "#/$defs/selector"},
            "stored_attributes_verified": {"$ref": "#/$defs/selector"},
            "symlink_denied": {"$ref": "#/$defs/selector"},
            "third_process_broker_denied": {"$ref": "#/$defs/selector"},
            "unsigned_package_denied": {"$ref": "#/$defs/selector"},
            "wrong_peer_denied": {"$ref": "#/$defs/selector"}
          }
        }
      }
    },
    "linux_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "distribution", "architecture", "package_format", "disposition", "isolation_class", "tuple", "native_store", "runner", "selectors"],
      "properties": {
        "platform": {"const": "linux"},
        "distribution": {"const": "ubuntu-22.04"},
        "architecture": {"const": "x86_64"},
        "package_format": {"enum": ["appimage", "deb"]},
        "disposition": {"const": "verified"},
        "isolation_class": {"const": "owner_session_scoped"},
        "tuple": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop_sha256", "writer_sha256", "daemon_sha256", "contract_sha256", "candidate_sha256", "tuple_sha256"],
          "properties": {
            "desktop_sha256": {"$ref": "#/$defs/sha256"},
            "writer_sha256": {"$ref": "#/$defs/sha256"},
            "daemon_sha256": {"$ref": "#/$defs/sha256"},
            "contract_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "tuple_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "native_store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_dbus", "keyring"],
          "properties": {
            "session_dbus": {"const": "verified"},
            "keyring": {"const": "verified"}
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_run_id", "attestation_verified"],
          "properties": {
            "workflow_run_id": {"type": "string", "minLength": 1},
            "attestation_verified": {"const": true}
          }
        },
        "selectors": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/selector"}
        }
      }
    },
    "windows_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "version", "architecture", "package_format", "disposition", "isolation_class", "tuple", "native_store", "runner", "selectors"],
      "properties": {
        "platform": {"const": "windows"},
        "version": {"const": "10-22H2"},
        "architecture": {"const": "x86_64"},
        "package_format": {"const": "nsis"},
        "disposition": {"const": "verified"},
        "isolation_class": {"const": "owner_session_scoped"},
        "tuple": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop_sha256", "writer_sha256", "daemon_sha256", "contract_sha256", "candidate_sha256", "tuple_sha256"],
          "properties": {
            "desktop_sha256": {"$ref": "#/$defs/sha256"},
            "writer_sha256": {"$ref": "#/$defs/sha256"},
            "daemon_sha256": {"$ref": "#/$defs/sha256"},
            "contract_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "tuple_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "native_store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credential_manager", "logon_session"],
          "properties": {
            "credential_manager": {"const": "verified"},
            "logon_session": {"const": "verified"}
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow_run_id", "attestation_verified"],
          "properties": {
            "workflow_run_id": {"type": "string", "minLength": 1},
            "attestation_verified": {"const": true}
          }
        },
        "selectors": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/selector"}
        }
      }
    }
  }
}
