{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.rc0.platform-qualified-subject/1",
  "title": "RUNNE RC0 Platform Qualified Subject V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "rc0_qualified_declaration_envelope_sha256", "rc0_verification_report_envelope_sha256", "common_binding_group_payload_sha256", "rc0_qualification_policy_digest", "mapping_policy_envelope_sha256", "active_activation_snapshot_envelope_sha256", "platform_attestation_envelope_sha256s", "normalized_platform_mapping_payload_sha256", "required_gate_set_payload_sha256", "profile_state_set_payload_sha256", "artifact_set_payload_sha256"],
  "properties": {
    "schema_version": {"const": "runne.rc0.platform-qualified-subject/1"},
    "repository_id": {"const": "runne"},
    "rc0_qualified_declaration_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "rc0_verification_report_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "common_binding_group_payload_sha256": {"$ref": "#/$defs/sha256"},
    "rc0_qualification_policy_digest": {"$ref": "#/$defs/sha256"},
    "mapping_policy_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "active_activation_snapshot_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "platform_attestation_envelope_sha256s": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "normalized_platform_mapping_payload_sha256": {"$ref": "#/$defs/sha256"},
    "required_gate_set_payload_sha256": {"$ref": "#/$defs/sha256"},
    "profile_state_set_payload_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_set_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
