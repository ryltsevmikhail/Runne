{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.platform-scope-mapping-policy/1",
  "title": "GOCODE RC0 Platform Scope Mapping Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "mapping_policy_revision", "activation_epoch", "predecessor_mapping_policy_envelope_sha256", "rc0_qualification_policy_digest", "shared_decision_payload_sha256", "shared_decision_schema_sha256", "runtime_adr_document_sha256", "desktop_adr_document_sha256", "runtime_owner_acceptance_envelope_sha256", "desktop_owner_acceptance_envelope_sha256", "adjunct_trust_registry_envelope_sha256", "adjunct_trust_registry_payload_sha256", "claim_migration_registry_payload_sha256", "claim_migration_registry_schema_sha256", "base_document_universe_payload_sha256", "classified_delta_payload_sha256", "composed_document_universe_payload_sha256", "platform_scopes", "artifact_slot_mappings", "profile_state_matrix", "host_identity_pins", "attestation_payload_schema_sha256", "qualified_subject_payload_schema_sha256", "matrix_payload_schema_sha256"],
  "properties": {
    "schema_version": {"const": "gocode.rc0.platform-scope-mapping-policy/1"}, "repository_id": {"const": "gocode"}, "mapping_policy_revision": {"type": "integer", "minimum": 1}, "activation_epoch": {"type": "integer", "minimum": 1}, "predecessor_mapping_policy_envelope_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "rc0_qualification_policy_digest": {"$ref": "#/$defs/sha256"}, "shared_decision_payload_sha256": {"$ref": "#/$defs/sha256"}, "shared_decision_schema_sha256": {"$ref": "#/$defs/sha256"}, "runtime_adr_document_sha256": {"$ref": "#/$defs/sha256"}, "desktop_adr_document_sha256": {"$ref": "#/$defs/sha256"}, "runtime_owner_acceptance_envelope_sha256": {"$ref": "#/$defs/sha256"}, "desktop_owner_acceptance_envelope_sha256": {"$ref": "#/$defs/sha256"}, "adjunct_trust_registry_envelope_sha256": {"$ref": "#/$defs/sha256"}, "adjunct_trust_registry_payload_sha256": {"$ref": "#/$defs/sha256"}, "claim_migration_registry_payload_sha256": {"$ref": "#/$defs/sha256"}, "claim_migration_registry_schema_sha256": {"$ref": "#/$defs/sha256"}, "base_document_universe_payload_sha256": {"$ref": "#/$defs/sha256"}, "classified_delta_payload_sha256": {"$ref": "#/$defs/sha256"}, "composed_document_universe_payload_sha256": {"$ref": "#/$defs/sha256"},
    "platform_scopes": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/scope"}}, "artifact_slot_mappings": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/slot"}}, "profile_state_matrix": {"type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": {"$ref": "#/$defs/profile"}}, "host_identity_pins": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/host_pin"}},
    "attestation_payload_schema_sha256": {"$ref": "#/$defs/sha256"}, "qualified_subject_payload_schema_sha256": {"$ref": "#/$defs/sha256"}, "matrix_payload_schema_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["platform_scope_id", "qualification_class", "support_disposition", "os_family", "os_version", "architecture", "required_gate_ids"], "properties": {"platform_scope_id": {"$ref": "#/$defs/scope_id"}, "qualification_class": {"enum": ["production", "development_preview"]}, "support_disposition": {"const": "supported"}, "os_family": {"enum": ["Ubuntu", "Windows", "macOS"]}, "os_version": {"type": "string", "minLength": 1, "maxLength": 4096}, "architecture": {"enum": ["x86_64", "arm64"]}, "required_gate_ids": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}}},
    "scope_id": {"enum": ["linux-ubuntu-24_04-x86_64-production", "windows-11-24h2-x86_64-production", "macos-14-arm64-development-preview"]},
    "slot": {"type": "object", "additionalProperties": false, "required": ["platform_scope_id", "artifact_slot_id", "artifact_kind"], "properties": {"platform_scope_id": {"$ref": "#/$defs/scope_id"}, "artifact_slot_id": {"enum": ["linux-appimage", "linux-deb", "windows-installer-unsigned", "macos-app-development-adhoc", "macos-dmg-development-adhoc"]}, "artifact_kind": {"type": "string", "minLength": 1, "maxLength": 4096}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["platform_scope_id", "profile_id", "profile_revision", "profile_sha256", "state"], "properties": {"platform_scope_id": {"$ref": "#/$defs/scope_id"}, "profile_id": {"type": "string", "minLength": 1, "maxLength": 4096}, "profile_revision": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1, "maxLength": 4096}]}, "profile_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "state": {"enum": ["required", "external_canary_only", "disabled_by_policy", "backend_unavailable"]}}},
    "host_pin": {"type": "object", "additionalProperties": false, "required": ["platform_scope_id", "os_build", "kernel_or_image_sha256", "backend_id", "backend_version", "probe_set_payload_sha256", "enforcement_descriptor_payload_sha256"], "properties": {"platform_scope_id": {"$ref": "#/$defs/scope_id"}, "os_build": {"type": "string", "minLength": 1, "maxLength": 4096}, "kernel_or_image_sha256": {"$ref": "#/$defs/sha256"}, "backend_id": {"type": "string", "minLength": 1, "maxLength": 4096}, "backend_version": {"type": "string", "minLength": 1, "maxLength": 4096}, "probe_set_payload_sha256": {"$ref": "#/$defs/sha256"}, "enforcement_descriptor_payload_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
