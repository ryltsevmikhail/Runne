{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.schema.verification-report/3",
  "title": "GOCODE RC0 External Verification Report V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "repository_id", "candidate_source_sha", "evidence_attempt_id", "observed_evidence_revision", "evidence_bundle_digest", "policy_revision", "policy_digest", "profile", "exact_artifact_bindings", "source_candidate_gate", "production_qualification_gate", "evidence_seal_gate", "overall_candidate_gate", "required_gate_results", "stage_dispositions", "runner_identity", "issued_at"],
  "properties": {
    "schema_id": {"const": "gocode.rc0.schema.verification-report/3"},
    "repository_id": {"type": "string", "minLength": 1},
    "candidate_source_sha": {"$ref": "#/$defs/gitSha"},
    "evidence_attempt_id": {"$ref": "#/$defs/uuidV7"},
    "observed_evidence_revision": {"$ref": "#/$defs/gitSha"},
    "evidence_bundle_digest": {"$ref": "#/$defs/sha256"},
    "policy_revision": {"type": "integer", "minimum": 1},
    "policy_digest": {"$ref": "#/$defs/sha256"},
    "profile": {"const": "gocode.rc0.evidence-profile/3"},
    "exact_artifact_bindings": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "source_candidate_gate": {"$ref": "#/$defs/aggregate"},
    "production_qualification_gate": {"$ref": "#/$defs/aggregate"},
    "evidence_seal_gate": {"$ref": "#/$defs/aggregate"},
    "overall_candidate_gate": {"$ref": "#/$defs/aggregate"},
    "required_gate_results": {"type": "array", "minItems": 2, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/gateRecord"}},
    "stage_dispositions": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/stageDisposition"}},
    "runner_identity": {"$ref": "#/$defs/runner"},
    "issued_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuidV7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "portablePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*]).+$"},
    "blockedReason": {"enum": ["REQUIRED_GATE_FAILED", "REQUIRED_GATE_NOT_RUN", "REQUIRED_GATE_MISMATCH", "REQUIRED_GATE_EVIDENCE_UNAVAILABLE", "REQUIRED_GATE_POLICY_UNAVAILABLE", "REQUIRED_GATE_AUTHORITY_UNAVAILABLE"]},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "size", "locator"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "locator": {"type": "string", "pattern": "^(?:cas:sha256:[0-9a-f]{64}|git:[0-9a-f]{40}:(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*?/\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*])(?!.*\\/$).+)$"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "candidate_source_sha", "evidence_attempt_id", "observed_evidence_revision", "evidence_bundle_digest", "policy_revision", "policy_digest", "profile", "exact_artifact_bindings"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "candidate_source_sha": {"$ref": "#/$defs/gitSha"},
        "evidence_attempt_id": {"$ref": "#/$defs/uuidV7"},
        "observed_evidence_revision": {"$ref": "#/$defs/gitSha"},
        "evidence_bundle_digest": {"$ref": "#/$defs/sha256"},
        "policy_revision": {"type": "integer", "minimum": 1},
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "profile": {"const": "gocode.rc0.evidence-profile/3"},
        "exact_artifact_bindings": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_result"],
      "properties": {
        "gate_result": {"enum": ["PASS", "BLOCKED"]},
        "blocked_reason": {"$ref": "#/$defs/blockedReason"}
      }
    },
    "gateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "stage", "execution_outcome", "gate_result", "binding"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "stage": {"enum": ["SOURCE_CANDIDATE", "PRODUCTION_QUALIFICATION"]},
        "execution_outcome": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "gate_result": {"enum": ["PASS", "BLOCKED"]},
        "blocked_reason": {"$ref": "#/$defs/blockedReason"},
        "binding": {"$ref": "#/$defs/binding"}
      }
    },
    "stageDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "report_stage_disposition"],
      "properties": {
        "stage": {"enum": ["RELEASE_APPROVAL", "PUBLICATION_AUTHORIZATION"]},
        "report_stage_disposition": {"const": "OUT_OF_SCOPE"}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_class", "executable_digest"],
      "properties": {
        "runner_class": {"type": "string", "minLength": 1},
        "executable_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
