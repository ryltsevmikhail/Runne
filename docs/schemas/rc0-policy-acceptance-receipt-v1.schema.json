{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.policy-acceptance-receipt/1",
  "title": "GOCODE RC0 Policy Acceptance Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "activation_intent_envelope_sha256", "consumer_role", "consumer_subject_id", "accepted_mapping_policy_envelope_sha256", "accepted_adjunct_trust_registry_envelope_sha256", "accepted_adjunct_trust_registry_payload_sha256", "accepted_rc0_qualification_policy_digest", "accepted_at", "consumer_verifier_build_sha256"],
  "properties": {
    "schema_version": {"const": "gocode.rc0.policy-acceptance-receipt/1"}, "repository_id": {"const": "gocode"}, "activation_intent_envelope_sha256": {"$ref": "#/$defs/sha256"}, "consumer_role": {"enum": ["runner", "downstream"]}, "consumer_subject_id": {"type": "string", "minLength": 1, "maxLength": 4096}, "accepted_mapping_policy_envelope_sha256": {"$ref": "#/$defs/sha256"}, "accepted_adjunct_trust_registry_envelope_sha256": {"$ref": "#/$defs/sha256"}, "accepted_adjunct_trust_registry_payload_sha256": {"$ref": "#/$defs/sha256"}, "accepted_rc0_qualification_policy_digest": {"$ref": "#/$defs/sha256"}, "accepted_at": {"$ref": "#/$defs/timestamp"}, "consumer_verifier_build_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"}}
}
