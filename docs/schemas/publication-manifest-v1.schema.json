{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"runne.release.publication-manifest/1","title":"Publication Manifest","type":"object","additionalProperties":false,"required":["schema_version","candidate_sha256","inventory_sha256","report_sha256","metadata_set_sha256","human_artifact_sha256","human_artifact_categories","version","channel","destination","artifacts","rollback_policy_sha256","rollout_policy_sha256","macos_preview_excluded"],"properties":{"schema_version":{"const":"runne.release.publication-manifest/1"},"candidate_sha256":{"$ref":"#/$defs/digest"},"inventory_sha256":{"$ref":"#/$defs/digest"},"report_sha256":{"$ref":"#/$defs/digest"},"metadata_set_sha256":{"$ref":"#/$defs/digest"},"human_artifact_sha256":{"type":"array","minItems":5,"maxItems":5,"items":{"$ref":"#/$defs/digest"}},"human_artifact_categories":{"const":["release_notes","changelog","compatibility_support","provenance","sbom"]},"version":{"type":"string","minLength":1,"maxLength":128},"channel":{"enum":["stable","beta","internal"]},"destination":{"type":"string","pattern":"^[A-Za-z0-9._:/-]{1,256}$"},"artifacts":{"const":["linux","windows"]},"rollback_policy_sha256":{"$ref":"#/$defs/digest"},"rollout_policy_sha256":{"$ref":"#/$defs/digest"},"macos_preview_excluded":{"const":true}},"$defs":{"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
