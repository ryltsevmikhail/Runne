{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gocode.dev/schemas/capability-grant.schema.json",
  "title": "Capability Grant",
  "description": "A Capability Grant authorizes an agent to perform specific actions.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "grantee": {
      "type": "string",
      "description": "Agent or TaskRun receiving the capability"
    },
    "scope": {
      "type": "object",
      "description": "Scope of the grant"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Grant TTL"
    }
  },
  "required": [
    "id",
    "capability",
    "grantee",
    "scope",
    "expires_at"
  ],
  "additionalProperties": false,
  "$comment": "Preliminary schema \u2014 subject to change. Do not use for implementation."
}
