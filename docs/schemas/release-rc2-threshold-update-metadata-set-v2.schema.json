{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.release.rc2-threshold-update-metadata-set/2",
  "title": "RC2 role-separated threshold update metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root", "targets", "snapshot", "timestamp"],
  "properties": {
    "schema_version": {"const": "gocode.release.rc2-threshold-update-metadata-set/2"},
    "root": {"$ref": "#/$defs/root"},
    "targets": {"$ref": "#/$defs/targets"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "timestamp": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "signature"],
      "properties": {"key_id": {"$ref": "#/$defs/id"}, "signature": {"$ref": "#/$defs/signature"}}
    },
    "proofs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/proof"}},
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "public_key"],
      "properties": {"key_id": {"$ref": "#/$defs/id"}, "public_key": {"$ref": "#/$defs/digest"}}
    },
    "common": {
      "type": "object",
      "required": ["role", "candidate_sha256", "inventory_sha256", "version", "rollback_floor", "expires_at", "revocation_epoch", "frozen"],
      "properties": {
        "role": {"type": "string"}, "candidate_sha256": {"$ref": "#/$defs/digest"},
        "inventory_sha256": {"$ref": "#/$defs/digest"}, "version": {"$ref": "#/$defs/positive"},
        "rollback_floor": {"$ref": "#/$defs/positive"}, "expires_at": {"$ref": "#/$defs/positive"},
        "revocation_epoch": {"$ref": "#/$defs/positive"}, "frozen": {"const": false}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "bundle_sha256"],
      "properties": {"profile_id": {"$ref": "#/$defs/id"}, "bundle_sha256": {"$ref": "#/$defs/digest"}}
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "app_version", "release_sequence", "bundle_id", "platform", "architecture", "artifact_sha256", "artifact_length", "min_os_policy_id", "min_os_policy_sha256", "profiles", "runtime_version", "runtime_sha256", "channel_selector"],
      "properties": {
        "slot": {"$ref": "#/$defs/id"}, "app_version": {"type": "string", "minLength": 1},
        "release_sequence": {"$ref": "#/$defs/positive"}, "bundle_id": {"$ref": "#/$defs/id"},
        "platform": {"enum": ["linux", "windows"]}, "architecture": {"enum": ["x86_64", "aarch64"]},
        "artifact_sha256": {"$ref": "#/$defs/digest"}, "artifact_length": {"$ref": "#/$defs/positive"},
        "min_os_policy_id": {"$ref": "#/$defs/id"}, "min_os_policy_sha256": {"$ref": "#/$defs/digest"},
        "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
        "runtime_version": {"type": "string", "minLength": 1}, "runtime_sha256": {"$ref": "#/$defs/digest"},
        "channel_selector": {"$ref": "#/$defs/id"}
      }
    },
    "root_body": {
      "allOf": [{"$ref": "#/$defs/common"}], "unevaluatedProperties": false,
      "required": ["keyset", "predecessor_body_sha256", "predecessor_keyset_sha256"],
      "properties": {"role": {"const": "root"}, "keyset": {"$ref": "#/$defs/keyset"}, "predecessor_body_sha256": {"$ref": "#/$defs/digest"}, "predecessor_keyset_sha256": {"$ref": "#/$defs/digest"}}
    },
    "targets_body": {
      "allOf": [{"$ref": "#/$defs/common"}], "unevaluatedProperties": false,
      "required": ["keyset", "root_body_sha256", "root_body_length", "root_version", "targets"],
      "properties": {"role": {"const": "targets"}, "keyset": {"$ref": "#/$defs/keyset"}, "root_body_sha256": {"$ref": "#/$defs/digest"}, "root_body_length": {"$ref": "#/$defs/positive"}, "root_version": {"$ref": "#/$defs/positive"}, "targets": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/linux_appimage_target"}, {"$ref": "#/$defs/linux_deb_target"}, {"$ref": "#/$defs/windows_target"}], "items": false}}
    },
    "online_body": {
      "allOf": [{"$ref": "#/$defs/common"}], "unevaluatedProperties": false,
      "required": ["key_id", "predecessor_body_sha256", "predecessor_body_length", "predecessor_version"],
      "properties": {"role": {"enum": ["snapshot", "timestamp"]}, "key_id": {"$ref": "#/$defs/id"}, "predecessor_body_sha256": {"$ref": "#/$defs/digest"}, "predecessor_body_length": {"$ref": "#/$defs/positive"}, "predecessor_version": {"$ref": "#/$defs/positive"}}
    },
    "keyset": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
    "linux_appimage_target": {"allOf": [{"$ref": "#/$defs/target"}], "properties": {"slot": {"const": "linux-appimage"}}},
    "linux_deb_target": {"allOf": [{"$ref": "#/$defs/target"}], "properties": {"slot": {"const": "linux-deb"}}},
    "windows_target": {"allOf": [{"$ref": "#/$defs/target"}], "properties": {"slot": {"const": "windows-installer-unsigned"}}},
    "root": {"type": "object", "additionalProperties": false, "required": ["body", "successor_authorization", "self_proof"], "properties": {"body": {"$ref": "#/$defs/root_body"}, "successor_authorization": {"$ref": "#/$defs/proofs"}, "self_proof": {"$ref": "#/$defs/proofs"}}},
    "targets": {"type": "object", "additionalProperties": false, "required": ["body", "root_authorization", "self_proof"], "properties": {"body": {"$ref": "#/$defs/targets_body"}, "root_authorization": {"$ref": "#/$defs/proofs"}, "self_proof": {"$ref": "#/$defs/proofs"}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["body", "signature"], "properties": {"body": {"$ref": "#/$defs/snapshot_body"}, "signature": {"$ref": "#/$defs/proof"}}},
    "timestamp": {"type": "object", "additionalProperties": false, "required": ["body", "signature"], "properties": {"body": {"$ref": "#/$defs/timestamp_body"}, "signature": {"$ref": "#/$defs/proof"}}},
    "snapshot_body": {"allOf": [{"$ref": "#/$defs/online_body"}], "properties": {"role": {"const": "snapshot"}}},
    "timestamp_body": {"allOf": [{"$ref": "#/$defs/online_body"}], "properties": {"role": {"const": "timestamp"}}}
  }
}
