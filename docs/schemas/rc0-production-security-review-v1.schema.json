{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"runne.rc0.production-security-review/1", "title":"RUNNE RC0 Production Security Review V1", "type":"object", "additionalProperties":false,
  "required":["schema_version","repository_id","review_state","reviewer","issuer","reviewed_closure_payload_sha256","issuer_key_id","issuer_key_epoch","revocation_epoch","signature_profile_id","issued_at","not_before","expires_at"],
  "properties":{"schema_version":{"const":"runne.rc0.production-security-review/1"},"repository_id":{"const":"runne"},"review_state":{"const":"APPROVED"},"reviewer":{"$ref":"#/$defs/principal"},"issuer":{"$ref":"#/$defs/principal"},"reviewed_closure_payload_sha256":{"$ref":"#/$defs/digest"},"issuer_key_id":{"$ref":"#/$defs/id"},"issuer_key_epoch":{"$ref":"#/$defs/u64"},"revocation_epoch":{"$ref":"#/$defs/u64"},"signature_profile_id":{"$ref":"#/$defs/id"},"issued_at":{"$ref":"#/$defs/time"},"not_before":{"$ref":"#/$defs/time"},"expires_at":{"$ref":"#/$defs/time"}},
  "$defs":{"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._-]{1,128}$"},"u64":{"type":"integer","minimum":0,"maximum":18446744073709551615},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"},"principal":{"type":"object","additionalProperties":false,"required":["role_id","subject_id","controlling_account_id","delegated_session_id","lane_id"],"properties":{"role_id":{"$ref":"#/$defs/id"},"subject_id":{"$ref":"#/$defs/id"},"controlling_account_id":{"$ref":"#/$defs/id"},"delegated_session_id":{"$ref":"#/$defs/id"},"lane_id":{"$ref":"#/$defs/id"}}}}
}
