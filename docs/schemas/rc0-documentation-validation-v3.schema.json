{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.rc0.schema.documentation-validation/3",
  "title": "RUNNE RC0 Documentation Validation V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "repository_id", "candidate_source_revision", "evidence_attempt_id", "policy_digest", "profile", "validations"],
  "properties": {
    "schema_id": {"const": "runne.rc0.schema.documentation-validation/3"},
    "repository_id": {"type": "string", "minLength": 1},
    "candidate_source_revision": {"$ref": "#/$defs/gitSha"},
    "evidence_attempt_id": {"$ref": "#/$defs/uuidV7"},
    "policy_digest": {"$ref": "#/$defs/sha256"},
    "profile": {"const": "runne.rc0.evidence-profile/3"},
    "validations": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/validation"}}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuidV7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_id", "category", "execution_outcome", "manifest_digest"],
      "properties": {
        "validation_id": {"type": "string", "minLength": 1},
        "category": {"enum": ["TAXONOMY", "DOCUMENT_UNIVERSE", "SCOPE_MANIFEST", "STATUS_CLAIMS", "ADR_POLICY"]},
        "execution_outcome": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "manifest_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
