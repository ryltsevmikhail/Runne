{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.artifact-measurement-record/1",
  "title": "GOCODE RC0 Artifact Measurement Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "mapping_policy_envelope_sha256",
    "adjunct_trust_registry_envelope_sha256",
    "adjunct_trust_registry_payload_sha256",
    "rc0_qualification_policy_digest",
    "active_activation_snapshot_envelope_sha256",
    "common_binding_group",
    "common_binding_group_payload_sha256",
    "platform_scope_id",
    "artifact_slot_id",
    "artifact_kind",
    "relative_path",
    "artifact_sha256",
    "size",
    "locator",
    "artifact_manifest_payload",
    "artifact_manifest_payload_sha256",
    "product_manifest_payload_sha256",
    "classifier_implementation_sha256",
    "classifier_dependency_set_sha256",
    "classifier_lane_id",
    "classifier_run_id",
    "observed_at",
    "freshness_deadline"
  ],
  "properties": {
    "schema_version": {
      "const": "gocode.rc0.artifact-measurement-record/1"
    },
    "repository_id": {
      "const": "gocode"
    },
    "mapping_policy_envelope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "adjunct_trust_registry_envelope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "adjunct_trust_registry_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "rc0_qualification_policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "active_activation_snapshot_envelope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "common_binding_group": {
      "$ref": "#/$defs/common"
    },
    "common_binding_group_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "platform_scope_id": {
      "$ref": "#/$defs/scope_id"
    },
    "artifact_slot_id": {
      "$ref": "#/$defs/slot_id"
    },
    "artifact_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "locator": {
      "type": "string",
      "minLength": 75,
      "maxLength": 75,
      "pattern": "^cas:sha256:[0-9a-f]{64}$"
    },
    "artifact_manifest_payload": {
      "$ref": "#/$defs/manifest_payload"
    },
    "artifact_manifest_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "product_manifest_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "classifier_implementation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "classifier_dependency_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "classifier_lane_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "classifier_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "freshness_deadline": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_id": {
      "enum": [
        "linux-ubuntu-24_04-x86_64-production",
        "windows-11-24h2-x86_64-production",
        "macos-14-arm64-development-preview"
      ]
    },
    "slot_id": {
      "enum": [
        "linux-appimage",
        "linux-deb",
        "windows-installer-unsigned",
        "macos-app-development-adhoc",
        "macos-dmg-development-adhoc"
      ]
    },
    "timestamp": {
      "type": "string",
      "anyOf": [
        {
          "type": "string",
          "minLength": 20,
          "maxLength": 20
        },
        {
          "type": "string",
          "minLength": 27,
          "maxLength": 27
        }
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "candidate_source_sha",
        "evidence_attempt_id",
        "observed_evidence_revision",
        "evidence_bundle_digest",
        "policy_revision",
        "policy_digest",
        "profile",
        "exact_artifact_bindings"
      ],
      "properties": {
        "repository_id": {
          "const": "gocode"
        },
        "candidate_source_sha": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence_attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "observed_evidence_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "evidence_bundle_digest": {"$ref": "#/$defs/sha256"},
        "policy_revision": {"type": "integer", "minimum": 1
        },
        "policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "const": "gocode.rc0.evidence-profile/3"
        },
        "exact_artifact_bindings": {
          "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
          "items": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "size", "locator"], "properties": {"relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*]).+$"}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}, "locator": {"type": "string", "pattern": "^(?:cas:sha256:[0-9a-f]{64}|git:[0-9a-f]{40}:(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*?/\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*])(?!.*\\/$).+)$"}}}
        }
      }
    },
    "raw_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "size",
        "locator"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "locator": {
          "type": "string",
          "minLength": 75,
          "maxLength": 75,
          "pattern": "^cas:sha256:[0-9a-f]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "size",
        "mode",
        "executable_architecture",
        "entitlement_capability_descriptor_sha256",
        "role"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "executable_architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "entitlement_capability_descriptor_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "shape_result": {
      "enum": [
        "PASS",
        "FAILED",
        "NOT_APPLICABLE"
      ]
    },
    "shape_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_normalization",
        "traversal",
        "symlink",
        "hardlink",
        "special_file",
        "case_collision",
        "unlisted_package_script",
        "linux_product_payload",
        "windows_helper",
        "macos_app_dmg"
      ],
      "properties": {
        "path_normalization": {
          "$ref": "#/$defs/shape_result"
        },
        "traversal": {
          "$ref": "#/$defs/shape_result"
        },
        "symlink": {
          "$ref": "#/$defs/shape_result"
        },
        "hardlink": {
          "$ref": "#/$defs/shape_result"
        },
        "special_file": {
          "$ref": "#/$defs/shape_result"
        },
        "case_collision": {
          "$ref": "#/$defs/shape_result"
        },
        "unlisted_package_script": {
          "$ref": "#/$defs/shape_result"
        },
        "linux_product_payload": {
          "$ref": "#/$defs/shape_result"
        },
        "windows_helper": {
          "$ref": "#/$defs/shape_result"
        },
        "macos_app_dmg": {
          "$ref": "#/$defs/shape_result"
        }
      }
    },
    "manifest_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_slot_id",
        "artifact_kind",
        "raw_artifact",
        "entries",
        "shape_results"
      ],
      "properties": {
        "schema_version": {
          "const": "gocode.rc0.artifact-manifest-payload/1"
        },
        "artifact_slot_id": {
          "$ref": "#/$defs/slot_id"
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "raw_artifact": {
          "$ref": "#/$defs/raw_artifact"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "shape_results": {
          "$ref": "#/$defs/shape_results"
        }
      }
    }
  }
}
