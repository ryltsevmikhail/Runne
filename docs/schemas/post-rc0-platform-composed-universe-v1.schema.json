{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.rc0.post-rc0-platform-composed-universe/1",
  "title": "RUNNE Post-RC0 Platform Composed Universe V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "base_document_universe_payload_sha256", "classified_delta_payload_sha256", "composed_document_universe_payload_sha256", "base_paths", "classified_delta_paths", "composed_paths"],
  "properties": {
    "schema_version": {"const": "runne.rc0.post-rc0-platform-composed-universe/1"}, "repository_id": {"const": "runne"}, "base_document_universe_payload_sha256": {"$ref": "#/$defs/sha256"}, "classified_delta_payload_sha256": {"$ref": "#/$defs/sha256"}, "composed_document_universe_payload_sha256": {"$ref": "#/$defs/sha256"}, "base_paths": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "classified_delta_paths": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "composed_paths": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[^\\u0000]+\\.(?:md|markdown)$", "maxLength": 4096}}
}
