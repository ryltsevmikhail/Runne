{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.governance.platform-decision-acceptance/1",
  "title": "RUNNE Platform Decision Acceptance V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "owner_domain", "owner_subject_id", "adr_id", "adr_document_sha256", "shared_decision_payload_sha256", "shared_decision_schema_sha256", "acceptance_revision", "accepted_at"],
  "properties": {
    "schema_version": {"const": "runne.governance.platform-decision-acceptance/1"},
    "repository_id": {"const": "runne"},
    "owner_domain": {"enum": ["runtime", "desktop"]},
    "owner_subject_id": {"$ref": "#/$defs/identifier"},
    "adr_id": {"enum": ["ADR-0027", "ADR-0015"]},
    "adr_document_sha256": {"$ref": "#/$defs/sha256"},
    "shared_decision_payload_sha256": {"$ref": "#/$defs/sha256"},
    "shared_decision_schema_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_revision": {"type": "integer", "minimum": 1},
    "accepted_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 4096},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"}
  }
}
