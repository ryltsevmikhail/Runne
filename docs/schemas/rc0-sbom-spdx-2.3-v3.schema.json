{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.rc0.schema.sbom-spdx-2.3/3",
  "title": "RUNNE RC0 SPDX 2.3 Binding V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "repository_id", "candidate_source_revision", "evidence_attempt_id", "policy_digest", "profile", "spdxVersion", "dataLicense", "SPDXID", "name", "documentNamespace", "artifact_bindings", "packages"],
  "properties": {
    "schema_id": {"const": "runne.rc0.schema.sbom-spdx-2.3/3"},
    "repository_id": {"type": "string", "minLength": 1},
    "candidate_source_revision": {"$ref": "#/$defs/gitSha"},
    "evidence_attempt_id": {"$ref": "#/$defs/uuidV7"},
    "policy_digest": {"$ref": "#/$defs/sha256"},
    "profile": {"const": "runne.rc0.evidence-profile/3"},
    "spdxVersion": {"const": "SPDX-2.3"},
    "dataLicense": {"const": "CC0-1.0"},
    "SPDXID": {"const": "SPDXRef-DOCUMENT"},
    "name": {"type": "string", "minLength": 1},
    "documentNamespace": {"type": "string", "minLength": 1},
    "artifact_bindings": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
    "packages": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/package"}}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuidV7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "portablePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*]).+$"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SPDXID", "name", "versionInfo", "downloadLocation", "licenseConcluded"],
      "properties": {
        "SPDXID": {"type": "string", "pattern": "^SPDXRef-[A-Za-z0-9.-]+$"},
        "name": {"type": "string", "minLength": 1},
        "versionInfo": {"type": "string", "minLength": 1},
        "downloadLocation": {"type": "string", "minLength": 1},
        "licenseConcluded": {"type": "string", "minLength": 1}
      }
    }
  }
}
