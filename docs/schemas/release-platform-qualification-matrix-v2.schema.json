{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.release.platform-qualification-matrix/2",
  "title": "RUNNE Release Platform Qualification Matrix V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "platform_qualified_subject_envelope_sha256", "normalized_platform_mapping", "normalized_platform_mapping_payload_sha256"],
  "properties": {
    "schema_version": {"const": "runne.release.platform-qualification-matrix/2"}, "repository_id": {"const": "runne"}, "platform_qualified_subject_envelope_sha256": {"$ref": "#/$defs/sha256"}, "normalized_platform_mapping": {"$ref": "#/$defs/mapping"}, "normalized_platform_mapping_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["schema_version", "repository_id", "cells"], "properties": {"schema_version": {"const": "runne.rc0.normalized-platform-mapping/1"}, "repository_id": {"const": "runne"}, "cells": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/cell"}}}},
    "cell": {"type": "object", "additionalProperties": false, "required": ["platform_scope_id", "qualification_class", "support_disposition", "os_family", "os_version", "os_build", "kernel_or_image_sha256", "architecture", "native_mode", "profile_rows", "artifact_rows", "evidence_envelope_sha256s"], "properties": {"platform_scope_id": {"enum": ["linux-ubuntu-24_04-x86_64-production", "windows-11-24h2-x86_64-production", "macos-14-arm64-development-preview"]}, "qualification_class": {"enum": ["production", "development_preview"]}, "support_disposition": {"enum": ["supported", "unsupported"]}, "os_family": {"enum": ["Ubuntu", "Windows", "macOS"]}, "os_version": {"type": "string", "minLength": 1, "maxLength": 4096}, "os_build": {"type": "string", "minLength": 1, "maxLength": 4096}, "kernel_or_image_sha256": {"$ref": "#/$defs/sha256"}, "architecture": {"enum": ["x86_64", "arm64"]}, "native_mode": {"const": "native"}, "profile_rows": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/profile"}}, "artifact_rows": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}, "evidence_envelope_sha256s": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_revision", "profile_sha256", "state", "evidence_envelope_sha256"], "properties": {"profile_id": {"type": "string", "minLength": 1, "maxLength": 4096}, "profile_revision": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1, "maxLength": 4096}]}, "profile_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "state": {"enum": ["required", "external_canary_only", "disabled_by_policy", "backend_unavailable"]}, "evidence_envelope_sha256": {"$ref": "#/$defs/sha256"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_slot_id", "relative_path", "sha256", "size", "locator", "artifact_manifest_payload_sha256", "product_manifest_payload_sha256"], "properties": {"artifact_slot_id": {"type": "string", "minLength": 1, "maxLength": 4096}, "relative_path": {"type": "string", "minLength": 1, "maxLength": 4096}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0}, "locator": {"type": "string", "pattern": "^cas:sha256:[0-9a-f]{64}$"}, "artifact_manifest_payload_sha256": {"$ref": "#/$defs/sha256"}, "product_manifest_payload_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
