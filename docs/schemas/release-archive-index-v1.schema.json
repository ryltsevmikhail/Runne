{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runne.dev/schemas/release-archive-index-v1.schema.json",
  "title": "RUNNE Release Archive Index V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "archive_sha256", "format", "size", "candidate_sha256", "entries"],
  "properties": {
    "schema_version": {"const": "release-archive-index-v1"},
    "archive_sha256": {"$ref": "#/$defs/sha256"},
    "format": {"const": "tar-ustar"},
    "size": {"type": "integer", "minimum": 0},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "mode", "size", "sha256"], "properties": {"path": {"type": "string"}, "kind": {"enum": ["file", "directory"]}, "mode": {"enum": ["0644", "0755"]}, "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
