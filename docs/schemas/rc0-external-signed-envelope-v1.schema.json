{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.external-signed-envelope/1",
  "title": "RUNNE External Signed Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "payload_schema_id", "payload_schema_sha256", "payload_sha256", "payload", "issuer", "issuer_key_id", "issuer_key_epoch", "issuer_subject_id", "issuer_controlling_account_id", "issuer_delegated_session_id", "issuer_lane_id", "issuer_role", "issuer_revocation_epoch", "signature_profile_id", "issued_at", "not_before", "expires_at", "signature"],
  "properties": {
    "schema_version": {"const": "runne.rc0.external-signed-envelope/1"},
    "payload_schema_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "payload_schema_sha256": {"$ref": "#/$defs/sha256"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "payload": {"type": "object", "maxProperties": 4096},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 4096},
    "issuer_key_id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "issuer_key_epoch": {"type": "integer", "minimum": 0},
    "issuer_subject_id": {"$ref": "#/$defs/identifier"},
    "issuer_controlling_account_id": {"$ref": "#/$defs/identifier"},
    "issuer_delegated_session_id": {"$ref": "#/$defs/identifier"},
    "issuer_lane_id": {"$ref": "#/$defs/identifier"},
    "issuer_role": {"$ref": "#/$defs/identifier"},
    "issuer_revocation_epoch": {"type": "integer", "minimum": 0},
    "signature_profile_id": {"$ref": "#/$defs/identifier"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "not_before": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "signature": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 4096},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"}
  }
}
