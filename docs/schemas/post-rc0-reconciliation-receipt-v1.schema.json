{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.post-rc0-reconciliation-receipt/1",
  "title": "GOCODE Post-RC0 Reconciliation Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "reconciled_integration_commit_sha", "reconciled_integration_tree_sha", "merge_base_sha", "bound_markdown_entries", "classified_path_decisions", "issuer_identity", "issuer_role", "trust", "issued_at", "expires_at", "revocation_epoch"],
  "properties": {
    "schema_version": {"const": "gocode.rc0.post-rc0-reconciliation-receipt/1"}, "repository_id": {"const": "gocode"}, "reconciled_integration_commit_sha": {"$ref": "#/$defs/git_oid"}, "reconciled_integration_tree_sha": {"$ref": "#/$defs/git_oid"}, "merge_base_sha": {"$ref": "#/$defs/git_oid"}, "bound_markdown_entries": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/bound_entry"}}, "classified_path_decisions": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/path_decision"}}, "issuer_identity": {"$ref": "#/$defs/principal"}, "issuer_role": {"const": "POST_RC0_RECONCILIATION_AUTHORITY"}, "trust": {"$ref": "#/$defs/trust"}, "issued_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/timestamp"}, "revocation_epoch": {"type": "integer", "minimum": 0}
  },
  "$defs": {"git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "identifier": {"type": "string", "minLength": 1, "maxLength": 4096}, "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[^\\u0000]+\\.(?:md|markdown)$", "maxLength": 4096}, "bound_entry": {"type": "object", "additionalProperties": false, "required": ["path", "blob_oid", "mode"], "properties": {"path": {"$ref": "#/$defs/path"}, "blob_oid": {"$ref": "#/$defs/git_oid"}, "mode": {"const": "100644"}}}, "path_decision": {"type": "object", "additionalProperties": false, "required": ["path", "classification", "reason"], "properties": {"path": {"$ref": "#/$defs/path"}, "classification": {"enum": ["governed", "non_governed", "superseded", "non_normative_exclusion"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 4096}}}, "principal": {"type": "object", "additionalProperties": false, "required": ["subject_id", "controlling_account_id", "delegated_session_id", "lane_id"], "properties": {"subject_id": {"$ref": "#/$defs/identifier"}, "controlling_account_id": {"$ref": "#/$defs/identifier"}, "delegated_session_id": {"$ref": "#/$defs/identifier"}, "lane_id": {"$ref": "#/$defs/identifier"}}}, "trust": {"type": "object", "additionalProperties": false, "required": ["verification_domain", "transcript_sha256", "issuer", "issuer_key_id", "issuer_key_epoch", "issuer_revocation_epoch", "signature_profile_id"], "properties": {"verification_domain": {"const": "PRODUCTION"}, "transcript_sha256": {"$ref": "#/$defs/sha256"}, "issuer": {"$ref": "#/$defs/identifier"}, "issuer_key_id": {"$ref": "#/$defs/identifier"}, "issuer_key_epoch": {"type": "integer", "minimum": 0}, "issuer_revocation_epoch": {"type": "integer", "minimum": 0}, "signature_profile_id": {"$ref": "#/$defs/identifier"}}}}
}
