{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.profile-evidence-record/1",
  "title": "GOCODE RC0 Profile Evidence Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "mapping_policy_envelope_sha256",
    "adjunct_trust_registry_envelope_sha256",
    "adjunct_trust_registry_payload_sha256",
    "rc0_qualification_policy_digest",
    "active_activation_snapshot_envelope_sha256",
    "common_binding_group",
    "common_binding_group_payload_sha256",
    "platform_scope_id",
    "profile_id",
    "profile_revision",
    "profile_sha256",
    "state",
    "canonical_result",
    "artifact_slot_ids",
    "rc0_gate_evidence_sha256s",
    "observed_at",
    "freshness_deadline"
  ],
  "properties": {
    "schema_version": {
      "const": "gocode.rc0.profile-evidence-record/1"
    },
    "repository_id": {
      "const": "gocode"
    },
    "mapping_policy_envelope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "adjunct_trust_registry_envelope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "adjunct_trust_registry_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "rc0_qualification_policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "active_activation_snapshot_envelope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "common_binding_group": {
      "$ref": "#/$defs/common"
    },
    "common_binding_group_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "platform_scope_id": {
      "$ref": "#/$defs/scope_id"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "profile_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      ]
    },
    "profile_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "required",
        "disabled_by_policy",
        "backend_unavailable"
      ]
    },
    "canonical_result": {
      "enum": [
        "PASS",
        "DISABLED_BY_POLICY",
        "BackendUnavailable"
      ]
    },
    "artifact_slot_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "rc0_gate_evidence_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "freshness_deadline": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_id": {
      "enum": [
        "linux-ubuntu-24_04-x86_64-production",
        "windows-11-24h2-x86_64-production",
        "macos-14-arm64-development-preview"
      ]
    },
    "timestamp": {
      "type": "string",
      "anyOf": [
        {
          "type": "string",
          "minLength": 20,
          "maxLength": 20
        },
        {
          "type": "string",
          "minLength": 27,
          "maxLength": 27
        }
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"
    },
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "candidate_source_sha",
        "evidence_attempt_id",
        "observed_evidence_revision",
        "evidence_bundle_digest",
        "policy_revision",
        "policy_digest",
        "profile",
        "exact_artifact_bindings"
      ],
      "properties": {
        "repository_id": {
          "const": "gocode"
        },
        "candidate_source_sha": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence_attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "observed_evidence_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "evidence_bundle_digest": {"$ref": "#/$defs/sha256"},
        "policy_revision": {"type": "integer", "minimum": 1
        },
        "policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "const": "gocode.rc0.evidence-profile/3"
        },
        "exact_artifact_bindings": {
          "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
          "items": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "size", "locator"], "properties": {"relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*]).+$"}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}, "locator": {"type": "string", "pattern": "^(?:cas:sha256:[0-9a-f]{64}|git:[0-9a-f]{40}:(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*?/\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*])(?!.*\\/$).+)$"}}}
        }
      }
    }
  }
}
