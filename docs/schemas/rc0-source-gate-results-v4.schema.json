{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.schema.source-gate-results/4",
  "title": "GOCODE RC0 Source Gate Results V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "repository_id",
    "candidate_source_revision",
    "evidence_attempt_id",
    "policy_digest",
    "profile",
    "capture"
  ],
  "properties": {
    "schema_id": {
      "const": "gocode.rc0.schema.source-gate-results/4"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_source_revision": {
      "$ref": "#/$defs/gitSha"
    },
    "evidence_attempt_id": {
      "$ref": "#/$defs/uuidV7"
    },
    "policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "profile": {
      "const": "gocode.rc0.evidence-profile/4"
    },
    "capture": {
      "$ref": "#/$defs/capture"
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_url",
        "captured_origin_main_revision",
        "head_revision",
        "raw_tree_oid",
        "current_tree_oid",
        "upstream_tree_oid",
        "upstream_blob_count",
        "upstream_content_digest",
        "opencode_source_sha",
        "capture_evidence_kind",
        "tree_clean"
      ],
      "properties": {
        "remote_url": {
          "type": "string",
          "pattern": "^https://git\\.sourcecraft\\.dev/ryltsevmg/runne\\.git$"
        },
        "captured_origin_main_revision": {
          "$ref": "#/$defs/gitSha"
        },
        "head_revision": {
          "$ref": "#/$defs/gitSha"
        },
        "raw_tree_oid": {
          "$ref": "#/$defs/gitSha"
        },
        "current_tree_oid": {
          "$ref": "#/$defs/gitSha"
        },
        "upstream_tree_oid": {
          "$ref": "#/$defs/gitSha"
        },
        "upstream_blob_count": {
          "type": "integer",
          "minimum": 1
        },
        "upstream_content_digest": {
          "$ref": "#/$defs/sha256"
        },
        "opencode_source_sha": {
          "const": "66495a2a22cd0a57efcc4f721e65532f0987b4e8"
        },
        "tree_clean": {
          "const": true
        },
        "capture_evidence_kind": {
          "enum": [
            "RAW_GIT_OBJECTS"
          ]
        }
      }
    }
  }
}
