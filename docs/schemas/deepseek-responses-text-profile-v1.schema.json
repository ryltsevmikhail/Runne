{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runne.dev/schemas/deepseek-responses-text-profile-v1.schema.json",
  "title": "Runne DeepSeek Responses Text Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_revision", "provider_id", "origin", "path", "model", "pricing", "capabilities", "developer_prompt", "request", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"const": "runne-deepseek-responses-text/1"},
    "profile_revision": {"const": 1},
    "provider_id": {"const": "deepseek"},
    "origin": {"const": "https://api.deepseek.com"},
    "path": {"const": "/responses"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "model_id", "revision", "aliases"],
      "properties": {
        "request_id": {"const": "deepseek-v4-flash"},
        "model_id": {"const": "deepseek-v4-flash"},
        "revision": {"const": "DeepSeek-V4-Flash-0731"},
        "aliases": {"const": []}
      }
    },
    "pricing": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "effective_from_unix_seconds", "currency", "unit_tokens", "peak_input_micros", "peak_cached_input_micros", "peak_output_micros", "off_peak_input_micros", "off_peak_cached_input_micros", "off_peak_output_micros", "peak_iso_weekdays", "peak_windows_utc", "long_context_threshold_tokens", "long_context_enabled"],
      "properties": {
        "revision": {"const": "deepseek-v4-flash-0731-peak-offpeak-2026-08-16/1"},
        "effective_from_unix_seconds": {"const": 1786896000},
        "currency": {"const": "USD"},
        "unit_tokens": {"const": 1000000},
        "peak_input_micros": {"const": 440000},
        "peak_cached_input_micros": {"const": 14000},
        "peak_output_micros": {"const": 1320000},
        "off_peak_input_micros": {"const": 220000},
        "off_peak_cached_input_micros": {"const": 7000},
        "off_peak_output_micros": {"const": 660000},
        "peak_iso_weekdays": {"const": [1, 2, 3, 4, 5]},
        "peak_windows_utc": {"const": [[60, 240], [360, 600]]},
        "long_context_threshold_tokens": {"const": 1000000},
        "long_context_enabled": {"const": false}
      }
    },
    "capabilities": {"const": ["streaming"]},
    "developer_prompt": {"type": "null"},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["reasoning_effort", "tools", "tool_choice", "stream"],
      "properties": {
        "reasoning_effort": {"const": "none"},
        "tools": {"const": []},
        "tool_choice": {"const": "none"},
        "stream": {"const": true}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_entries", "max_input_entry_bytes", "max_input_bytes", "max_output_tokens", "max_request_bytes"],
      "properties": {
        "max_input_entries": {"const": 64},
        "max_input_entry_bytes": {"const": 65536},
        "max_input_bytes": {"const": 262144},
        "max_output_tokens": {"const": 16384},
        "max_request_bytes": {"const": 524288}
      }
    }
  }
}
