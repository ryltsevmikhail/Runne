{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gocode.dev/schemas/deepseek-responses-text-profile-v1.schema.json",
  "title": "GOCODE OpenAI Responses Text Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_revision",
    "provider_id",
    "origin",
    "path",
    "model",
    "pricing",
    "capabilities",
    "developer_prompt",
    "request",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "const": "gocode-deepseek-responses-text/1"
    },
    "profile_revision": {
      "const": 1
    },
    "provider_id": {
      "const": "deepseek"
    },
    "origin": {
      "const": "https://api.deepseek.com"
    },
    "path": {
      "const": "/v1/responses"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "model_id", "revision", "aliases"],
      "properties": {
        "request_id": {
          "const": "deepseek-chat"
        },
        "model_id": {
          "const": "deepseek-chat"
        },
        "revision": {
          "const": "2026-08-16"
        },
        "aliases": {
          "const": []
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "currency",
        "unit_tokens",
        "input_micros",
        "cached_input_micros",
        "output_micros",
        "long_context_threshold_tokens",
        "long_context_enabled"
      ],
      "properties": {
        "revision": {
          "const": "deepseek-chat-base-2026-08-16/1"
        },
        "currency": {
          "const": "USD"
        },
        "unit_tokens": {
          "const": 1000000
        },
        "input_micros": {
          "const": 270000
        },
        "cached_input_micros": {
          "const": 28000
        },
        "output_micros": {
          "const": 1100000
        },
        "long_context_threshold_tokens": {
          "const": 1000000
        },
        "long_context_enabled": {
          "const": false
        }
      }
    },
    "capabilities": {
      "const": ["streaming"]
    },
    "developer_prompt": {
      "type": "null"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_tier",
        "reasoning_effort",
        "tools",
        "tool_choice",
        "background",
        "store",
        "stream"
      ],
      "properties": {
        "service_tier": {
          "const": "default"
        },
        "reasoning_effort": {
          "const": "none"
        },
        "tools": {
          "const": []
        },
        "tool_choice": {
          "const": "none"
        },
        "background": {
          "const": false
        },
        "store": {
          "const": false
        },
        "stream": {
          "const": true
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_entries",
        "max_input_entry_bytes",
        "max_input_bytes",
        "max_output_tokens",
        "max_request_bytes"
      ],
      "properties": {
        "max_input_entries": {
          "const": 64
        },
        "max_input_entry_bytes": {
          "const": 65536
        },
        "max_input_bytes": {
          "const": 262144
        },
        "max_output_tokens": {
          "const": 16384
        },
        "max_request_bytes": {
          "const": 524288
        }
      }
    }
  }
}
