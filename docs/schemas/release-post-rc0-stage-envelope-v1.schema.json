{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"gocode.release.post-rc0-stage-envelope/1", "title":"GOCODE Post-RC0 Stage Authority Envelope", "description":"Canonical authority container only; it does not execute a release stage.", "type":"object", "additionalProperties":false,
  "required":["schema_version","repository_id","bootstrap_receipt_sha256","issuer_role","issuer_principal_id","issuer_controlling_account_id","issuer_lane_id","issuer_key_id","issuer_key_epoch","signature_profile_id","payload_schema_id","payload_schema_sha256","payload_sha256","payload","issued_at","not_before","expires_at","revocation_epoch","authorization_nonce","signature"],
  "properties":{"schema_version":{"const":"gocode.release.post-rc0-stage-envelope/1"},"repository_id":{"const":"gocode"},"bootstrap_receipt_sha256":{"$ref":"#/$defs/sha256"},"issuer_role":{"enum":["RC1_QUALIFICATION_AUTHORIZER","RC2_SIGNING_AUTHORIZER","RC3_PUBLICATION_AUTHORIZER"]},"issuer_principal_id":{"$ref":"#/$defs/safe_id"},"issuer_controlling_account_id":{"$ref":"#/$defs/safe_id"},"issuer_lane_id":{"$ref":"#/$defs/safe_id"},"issuer_key_id":{"$ref":"#/$defs/sha256"},"issuer_key_epoch":{"$ref":"#/$defs/u64"},"signature_profile_id":{"$ref":"#/$defs/safe_id"},"payload_schema_id":{"type":"string"},"payload_schema_sha256":{"$ref":"#/$defs/sha256"},"payload_sha256":{"$ref":"#/$defs/sha256"},"payload":{"type":"object"},"issued_at":{"$ref":"#/$defs/time"},"not_before":{"$ref":"#/$defs/time"},"expires_at":{"$ref":"#/$defs/time"},"revocation_epoch":{"$ref":"#/$defs/u64"},"authorization_nonce":{"$ref":"#/$defs/safe_id"},"signature":{"$ref":"#/$defs/signature"}},
  "allOf":[{"if":{"properties":{"issuer_role":{"const":"RC1_QUALIFICATION_AUTHORIZER"}}},"then":{"properties":{"payload_schema_id":{"const":"gocode.release.rc1-qualification-decision/1"}}}},{"if":{"properties":{"issuer_role":{"const":"RC2_SIGNING_AUTHORIZER"}}},"then":{"properties":{"payload_schema_id":{"const":"gocode.release.rc2-signing-authorization/1"}}}},{"if":{"properties":{"issuer_role":{"const":"RC3_PUBLICATION_AUTHORIZER"}}},"then":{"properties":{"payload_schema_id":{"const":"gocode.release.rc3-publication-authorization/1"}}}}],
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"safe_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,127}$"},"u64":{"type":"integer","minimum":1,"maximum":18446744073709551615},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"base64url":{"type":"string","pattern":"^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"},"signature":{"$ref":"#/$defs/base64url","minLength":86,"maxLength":86}}
}
