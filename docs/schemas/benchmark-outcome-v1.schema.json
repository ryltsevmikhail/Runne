{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runne.dev/schemas/benchmark-outcome-v1.schema.json",
  "title": "Runne Benchmark Outcome V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "technical_outcome", "acceptance", "manual_override", "execution_status", "verifier_result", "effect_state", "recovery_state", "evidence_complete", "timing", "usage", "cost"],
  "properties": {
    "schema_version": {"const": "runne.benchmark.outcome/1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "technical_outcome": {"enum": ["Verified", "Unverified", "Uncertain", "Failed"]},
    "acceptance": {"enum": ["Accepted", "Rejected", "Pending", "NotApplicable"]},
    "manual_override": {"type": "boolean"},
    "execution_status": {"enum": ["completed", "failed"]},
    "verifier_result": {"enum": ["passed", "failed", "inconclusive", "not_run"]},
    "effect_state": {"enum": ["none", "confirmed", "uncertain", "failed"]},
    "recovery_state": {"enum": ["clean", "uncertain", "failed"]},
    "evidence_complete": {"type": "boolean"},
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_seconds", "review_minutes", "recovery_minutes"],
      "properties": {
        "task_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
        "review_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "recovery_minutes": {"type": "integer", "minimum": 0, "maximum": 1440}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "model_compute_micros", "human_review_micros", "recovery_micros"],
      "properties": {
        "currency": {"const": "USD"},
        "model_compute_micros": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "human_review_micros": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "recovery_micros": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      }
    }
  }
}
