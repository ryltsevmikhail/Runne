{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.release.publication-effect-ledger/1",
  "title": "Publication Effect Ledger V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": {"const": "gocode.release.publication-effect-ledger/1"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[^\\s]+$"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "state": {"enum": ["claimed", "in_flight", "succeeded", "uncertain", "reconciled_succeeded", "reconciled_absent", "blocked"]},
    "intent": {"$ref": "publication-effect-intent-v1.schema.json"},
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "generation", "evidence_sha256"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "evidence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "claim_command": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "command_id", "intent", "observed_at", "current_revocation_epoch", "current_allowlist_generation"],
      "properties": {
        "kind": {"const": "claim"}, "command_id": {"$ref": "#/$defs/id"}, "intent": {"$ref": "#/$defs/intent"},
        "observed_at": {"$ref": "#/$defs/u64"}, "current_revocation_epoch": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "current_allowlist_generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
      }
    },
    "dispatch_command": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "command_id", "intent", "capability_sha256", "observed_at", "current_revocation_epoch", "current_allowlist_generation"],
      "properties": {
        "kind": {"const": "dispatch"}, "command_id": {"$ref": "#/$defs/id"}, "intent": {"$ref": "#/$defs/intent"}, "capability_sha256": {"$ref": "#/$defs/digest"},
        "observed_at": {"$ref": "#/$defs/u64"}, "current_revocation_epoch": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "current_allowlist_generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
      }
    },
    "capability_command": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "command_id", "intent", "capability_sha256"],
      "properties": {"kind": {"const": "mark_uncertain"}, "command_id": {"$ref": "#/$defs/id"}, "intent": {"$ref": "#/$defs/intent"}, "capability_sha256": {"$ref": "#/$defs/digest"}}
    },
    "settlement_command": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "command_id", "intent", "capability_sha256", "evidence_sha256"],
      "properties": {"kind": {"const": "succeed_settlement"}, "command_id": {"$ref": "#/$defs/id"}, "intent": {"$ref": "#/$defs/intent"}, "capability_sha256": {"$ref": "#/$defs/digest"}, "evidence_sha256": {"$ref": "#/$defs/digest"}}
    },
    "reconcile_command": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "command_id", "intent", "capability_sha256", "evidence_sha256"],
      "properties": {"kind": {"enum": ["reconcile_succeeded", "reconcile_absent", "reconcile_inconclusive"]}, "command_id": {"$ref": "#/$defs/id"}, "intent": {"$ref": "#/$defs/intent"}, "capability_sha256": {"$ref": "#/$defs/digest"}, "evidence_sha256": {"$ref": "#/$defs/digest"}}
    },
    "reclaim_command": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "command_id", "intent", "capability_sha256", "observed_at", "current_revocation_epoch", "current_allowlist_generation"],
      "properties": {
        "kind": {"const": "reclaim"}, "command_id": {"$ref": "#/$defs/id"}, "intent": {"$ref": "#/$defs/intent"}, "capability_sha256": {"$ref": "#/$defs/digest"},
        "observed_at": {"$ref": "#/$defs/u64"}, "current_revocation_epoch": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "current_allowlist_generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
      }
    },
    "command": {"oneOf": [{"$ref": "#/$defs/claim_command"}, {"$ref": "#/$defs/dispatch_command"}, {"$ref": "#/$defs/capability_command"}, {"$ref": "#/$defs/settlement_command"}, {"$ref": "#/$defs/reconcile_command"}, {"$ref": "#/$defs/reclaim_command"}]},
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "command_fingerprint_sha256", "outcome"],
      "properties": {"command": {"$ref": "#/$defs/command"}, "command_fingerprint_sha256": {"$ref": "#/$defs/digest"}, "outcome": {"$ref": "#/$defs/outcome"}}
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "intent", "state", "reconciliations", "settlement_sha256", "commands"],
      "properties": {
        "namespace": {"$ref": "#/$defs/id"}, "intent": {"$ref": "#/$defs/intent"}, "state": {"$ref": "#/$defs/state"},
        "reconciliations": {"type": "integer", "minimum": 0, "maximum": 1}, "settlement_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
      }
    }
  }
}
