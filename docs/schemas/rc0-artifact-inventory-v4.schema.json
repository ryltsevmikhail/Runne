{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.schema.artifact-inventory/4",
  "title": "GOCODE RC0 Artifact Inventory V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "repository_id",
    "candidate_source_revision",
    "evidence_attempt_id",
    "policy_digest",
    "profile",
    "artifacts"
  ],
  "properties": {
    "schema_id": {
      "const": "gocode.rc0.schema.artifact-inventory/4"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_source_revision": {
      "$ref": "#/$defs/gitSha"
    },
    "evidence_attempt_id": {
      "$ref": "#/$defs/uuidV7"
    },
    "policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "profile": {
      "const": "gocode.rc0.evidence-profile/4"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "size",
        "locator",
        "kind"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/portablePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "locator": {
          "type": "string",
          "pattern": "^(?:cas:sha256:[0-9a-f]{64}|git:[0-9a-f]{40}:(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*?/\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*])(?!.*\\/$).+)$"
        },
        "kind": {
          "enum": [
            "UNSIGNED_ARCHIVE",
            "BINARY",
            "SBOM",
            "METADATA"
          ]
        }
      }
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*]).+$"
    }
  }
}
