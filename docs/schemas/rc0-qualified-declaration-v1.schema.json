{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.rc0.qualified-declaration/1",
  "title": "GOCODE RC0 Qualified Declaration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "declaration_state", "common_binding_group", "common_binding_group_payload_sha256", "rc0_qualification_policy_digest", "verification_report_envelope_sha256", "required_gate_set_payload_sha256", "artifact_set_payload_sha256", "runner_lane_id"],
  "properties": {
    "schema_version": {"const": "gocode.rc0.qualified-declaration/1"},
    "repository_id": {"const": "gocode"},
    "declaration_state": {"const": "RC0_QUALIFIED"},
    "common_binding_group": {"$ref": "#/$defs/common_binding_group"},
    "common_binding_group_payload_sha256": {"$ref": "#/$defs/sha256"},
    "rc0_qualification_policy_digest": {"$ref": "#/$defs/sha256"},
    "verification_report_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "required_gate_set_payload_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_set_payload_sha256": {"$ref": "#/$defs/sha256"},
    "runner_lane_id": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "uuid_v7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "portable_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*]).+$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "size", "locator"], "properties": {"relative_path": {"$ref": "#/$defs/portable_path"}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}, "locator": {"type": "string", "pattern": "^(?:cas:sha256:[0-9a-f]{64}|git:[0-9a-f]{40}:(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\.\\.?(?:/|$))(?!.*?/\\.\\.?(?:/|$))(?!.*[\\u0000-\\u001f\\u007f])(?!.*[<>:\"|?*])(?!.*\\/$).+)$"}}},
    "common_binding_group": {"type": "object", "additionalProperties": false, "required": ["repository_id", "candidate_source_sha", "evidence_attempt_id", "observed_evidence_revision", "evidence_bundle_digest", "policy_revision", "policy_digest", "profile", "exact_artifact_bindings"], "properties": {"repository_id": {"const": "gocode"}, "candidate_source_sha": {"$ref": "#/$defs/git_sha"}, "evidence_attempt_id": {"$ref": "#/$defs/uuid_v7"}, "observed_evidence_revision": {"$ref": "#/$defs/git_sha"}, "evidence_bundle_digest": {"$ref": "#/$defs/sha256"}, "policy_revision": {"type": "integer", "minimum": 1}, "policy_digest": {"$ref": "#/$defs/sha256"}, "profile": {"const": "gocode.rc0.evidence-profile/3"}, "exact_artifact_bindings": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}}}
  }
}
