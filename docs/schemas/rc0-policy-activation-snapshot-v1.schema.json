{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runne.rc0.policy-activation-snapshot/1",
  "title": "RUNNE RC0 Policy Activation Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "activation_id", "activation_intent_envelope_sha256", "mapping_policy_envelope_sha256", "adjunct_trust_registry_envelope_sha256", "adjunct_trust_registry_payload_sha256", "rc0_qualification_policy_digest", "activation_epoch", "predecessor_activation_snapshot_envelope_sha256", "runner_acceptance_receipt_envelope_sha256", "downstream_acceptance_receipt_envelope_sha256", "state", "activated_at"],
  "properties": {
    "schema_version": {"const": "runne.rc0.policy-activation-snapshot/1"}, "repository_id": {"const": "runne"}, "activation_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "activation_intent_envelope_sha256": {"$ref": "#/$defs/sha256"}, "mapping_policy_envelope_sha256": {"$ref": "#/$defs/sha256"}, "adjunct_trust_registry_envelope_sha256": {"$ref": "#/$defs/sha256"}, "adjunct_trust_registry_payload_sha256": {"$ref": "#/$defs/sha256"}, "rc0_qualification_policy_digest": {"$ref": "#/$defs/sha256"}, "activation_epoch": {"type": "integer", "minimum": 1}, "predecessor_activation_snapshot_envelope_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "runner_acceptance_receipt_envelope_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "downstream_acceptance_receipt_envelope_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "state": {"enum": ["active", "revoked"]}, "activated_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"}}
}
