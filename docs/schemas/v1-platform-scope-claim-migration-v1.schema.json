{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gocode.v1-platform-scope-claim-migration/1",
  "title": "GOCODE V1 Platform Scope Claim Migration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "registry_revision", "base_document_universe_payload_sha256", "classified_delta_payload_sha256", "composed_document_universe_payload_sha256", "claims"],
  "properties": {
    "schema_version": {"const": "gocode.v1-platform-scope-claim-migration/1"}, "repository_id": {"const": "gocode"}, "registry_revision": {"type": "integer", "minimum": 1}, "base_document_universe_payload_sha256": {"$ref": "#/$defs/sha256"}, "classified_delta_payload_sha256": {"$ref": "#/$defs/sha256"}, "composed_document_universe_payload_sha256": {"$ref": "#/$defs/sha256"}, "claims": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[^\\u0000]+\\.(?:md|markdown)$", "maxLength": 4096},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "literal_needles", "expected_paths", "disposition", "replacement_adr_ids", "owner", "reason"], "properties": {"claim_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"}, "literal_needles": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "expected_paths": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "disposition": {"enum": ["superseded", "non_normative_exclusion"]}, "replacement_adr_ids": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["ADR-0027", "ADR-0015"]}}, "owner": {"enum": ["gocode-runtime", "gocode-desktop", "shared"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 4096}}}
  }
}
