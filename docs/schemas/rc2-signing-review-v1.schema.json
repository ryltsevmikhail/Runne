{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"gocode.release.rc2-signing-review/1","title":"RC2 Signing Review","type":"object","additionalProperties":false,"required":["schema_version","signing_authorization_sha256","inventory_sha256","native_evidence_sha256","reviewer","approval","valid_from","expires_at","revocation_epoch"],"properties":{"schema_version":{"const":"gocode.release.rc2-signing-review/1"},"signing_authorization_sha256":{"$ref":"#/$defs/digest"},"inventory_sha256":{"$ref":"#/$defs/digest"},"native_evidence_sha256":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}},"reviewer":{"$ref":"#/$defs/identity"},"approval":{"const":"approved"},"valid_from":{"$ref":"#/$defs/u64"},"expires_at":{"$ref":"#/$defs/positive"},"revocation_epoch":{"$ref":"#/$defs/positive"}},"$defs":{"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"id":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,128}$"},"u64":{"type":"integer","minimum":0,"maximum":18446744073709551615},"positive":{"type":"integer","minimum":1,"maximum":18446744073709551615},"identity":{"type":"object","additionalProperties":false,"required":["principal_id","account_id","lane_id","key_id","signature_profile_id"],"properties":{"principal_id":{"$ref":"#/$defs/id"},"account_id":{"$ref":"#/$defs/id"},"lane_id":{"$ref":"#/$defs/id"},"key_id":{"$ref":"#/$defs/id"},"signature_profile_id":{"$ref":"#/$defs/id"}}}}}
